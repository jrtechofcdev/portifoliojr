// Worker da escolha das fotos pelas modelos. Montagem e publicação: `npm run escolha:montar`
// (precisa de `npx wrangler login` uma vez). O database_id é preenchido pelo próprio script.
{
  "name": "jr-escolha",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./publico",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jr-escolha",
      "database_id": "ebf8d380-67cf-47bb-a88d-7af158fe88f7"
    }
  ],
  "routes": [{ "pattern": "escolha.jrtechofc.com.br", "custom_domain": true }]
}
