{
  "name": "portfolio-jr-tech-ofc",
  "private": true,
  "version": "1.0.0",
  "description": "Portfólio de fotografia da Jr_Tech_OFC (José Renato Alves da Silva), Bacabal e Imperatriz, MA.",
  "author": "José Renato Alves da Silva",
  "license": "UNLICENSED",
  "homepage": "https://portifolio.jrtechofc.com.br",
  "type": "module",
  "scripts": {
    "fotos": "node scripts/fotos.mjs",
    "fotos:prod": "node scripts/fotos.mjs --producao",
    "dev": "node scripts/fotos.mjs && astro dev",
    "build": "node scripts/fotos.mjs --producao && astro check && astro build && node scripts/verificar-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:bloqueio": "node scripts/testar-bloqueio.mjs",
    "build:previa": "node scripts/fotos.mjs && astro check && astro build",
    "build:vercel": "node scripts/verificar-fotos-prontas.mjs && astro build",
    "fotos:publicar": "node scripts/fotos.mjs --producao",
    "icones": "node scripts/icones.mjs",
    "capa": "node scripts/capa-compartilhamento.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
