---
// Álbum de luxo que se folheia: cada filho com a classe "pagina" vira uma página.
// Desktop: página dupla, a folha vira em torno da lombada. Celular: uma página por vez.
// Sem JavaScript, as páginas ficam numa faixa com rolagem lateral (nada some).
// Slot "fechado": texto que fica ao lado do álbum fechado (só no desktop, some quando abre).
interface Props {
  rotulo: string;
  id?: string;
  /** Quantas vezes o álbum pode ser maior na home (abertura) do que numa seção comum. */
  abertura?: boolean;
}
const { rotulo, id, abertura = false } = Astro.props;
const temFechado = Astro.slots.has('fechado');
---

<div class:list={['album', { 'album-abertura': abertura, 'com-fechado': temFechado }]} id={id} data-album>
  {temFechado && <div class="album-fechado"><slot name="fechado" /></div>}
  <div class="album-janela">
    <div class="album-livro" role="region" aria-roledescription="álbum" aria-label={rotulo}>
      <slot />
    </div>
  </div>
  <div class="album-controles" hidden data-controles>
    <button type="button" class="album-btn" data-ant aria-label="Página anterior">
      <span aria-hidden="true">←</span> <span class="album-btn-txt">Voltar</span>
    </button>
    <span class="album-conta legenda" aria-live="polite" data-conta></span>
    <button type="button" class="album-btn" data-prox aria-label="Próxima página">
      <span class="album-btn-txt">Virar a página</span> <span aria-hidden="true">→</span>
    </button>
  </div>
</div>

<script>
  const DUPLO = matchMedia('(min-width: 900px)');

  class Album {
    raiz: HTMLElement;
    livro: HTMLElement;
    paginas: HTMLElement[];
    folhas: HTMLElement[] = [];
    duplo = DUPLO.matches;
    f = 0; // folhas já viradas
    emMovimento: HTMLElement[] = [];
    relogio = 0;
    conta: HTMLElement;
    ant: HTMLButtonElement;
    prox: HTMLButtonElement;

    constructor(raiz: HTMLElement) {
      this.raiz = raiz;
      this.livro = raiz.querySelector('.album-livro')!;
      this.paginas = [...this.livro.querySelectorAll<HTMLElement>(':scope > .pagina')];
      this.conta = raiz.querySelector('[data-conta]')!;
      this.ant = raiz.querySelector('[data-ant]')!;
      this.prox = raiz.querySelector('[data-prox]')!;
      raiz.querySelector<HTMLElement>('[data-controles]')!.hidden = false;
      raiz.classList.add('album-ativo');
      this.montar();

      this.ant.addEventListener('click', () => this.ir(this.f - 1));
      this.prox.addEventListener('click', () => this.ir(this.f + 1));
      raiz.querySelectorAll<HTMLElement>('[data-album-abrir]').forEach((b) => b.addEventListener('click', () => this.ir(1)));
      raiz.querySelectorAll<HTMLAnchorElement>('[data-album-pagina]').forEach((a) =>
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          this.irParaPagina(Number(a.dataset.albumPagina));
        }),
      );
      raiz.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowRight') this.ir(this.f + 1);
        else if (ev.key === 'ArrowLeft') this.ir(this.f - 1);
        else return;
        ev.preventDefault();
      });
      // Clicar na página da direita avança; na da esquerda, volta (fora de links e botões).
      this.livro.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).closest('a, button')) return;
        const r = this.livro.getBoundingClientRect();
        const direita = this.duplo ? ev.clientX > r.left + r.width / 2 : ev.clientX > r.left + r.width * 0.3;
        this.ir(this.f + (direita ? 1 : -1));
      });
      // Deslizar no celular
      let x0 = 0;
      let y0 = 0;
      this.livro.addEventListener('pointerdown', (ev) => ((x0 = ev.clientX), (y0 = ev.clientY)));
      this.livro.addEventListener('pointerup', (ev) => {
        const dx = ev.clientX - x0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(ev.clientY - y0)) this.ir(this.f + (dx < 0 ? 1 : -1));
      });
      DUPLO.addEventListener('change', () => {
        const pagina = this.paginaAtual();
        this.duplo = DUPLO.matches;
        this.montar();
        this.irParaPagina(pagina, false);
      });
    }

    get maximo() {
      // A última vista sempre mostra a última página à direita.
      return this.duplo ? Math.ceil(this.paginas.length / 2) - (this.paginas.length % 2 ? 1 : 0) : this.paginas.length - 1;
    }

    paginaAtual() {
      return this.duplo ? Math.max(0, this.f * 2 - 1) : this.f;
    }

    irParaPagina(p: number, animar = true) {
      this.ir(this.duplo ? Math.ceil(p / 2) : p, animar);
    }

    montar() {
      const branca = () => {
        const d = document.createElement('div');
        d.className = 'pagina pagina-papel pagina-branca';
        return d;
      };
      const pares: [HTMLElement, HTMLElement][] = [];
      if (this.duplo) for (let i = 0; i < this.paginas.length; i += 2) pares.push([this.paginas[i], this.paginas[i + 1] ?? branca()]);
      else for (const p of this.paginas) pares.push([p, branca()]);
      this.folhas = pares.map(([frente, verso]) => {
        const folha = document.createElement('div');
        folha.className = 'folha';
        const a = document.createElement('div');
        a.className = 'face face-frente';
        a.append(frente);
        const b = document.createElement('div');
        b.className = 'face face-verso';
        b.append(verso);
        folha.append(a, b);
        return folha;
      });
      this.livro.replaceChildren(...this.folhas);
      this.raiz.classList.toggle('album-duplo', this.duplo);
      this.f = Math.min(this.f, this.maximo);
      this.desenhar(false);
    }

    ir(f: number, animar = true) {
      const alvo = Math.max(0, Math.min(this.maximo, f));
      if (alvo === this.f) return;
      const anterior = this.f;
      this.f = alvo;
      // A folha que está virando fica por cima das outras durante o movimento.
      // Durante a virada, todas as folhas entre a vista antiga e a nova ficam visíveis.
      const de = Math.min(anterior, alvo);
      const ate = Math.max(anterior, alvo);
      const virando = this.folhas.slice(de, ate);
      virando.forEach((f) => f.classList.add('virando'));
      this.emMovimento = virando;
      this.desenhar(animar);
      clearTimeout(this.relogio);
      this.relogio = window.setTimeout(() => {
        virando.forEach((f) => f.classList.remove('virando'));
        this.emMovimento = [];
        this.desenhar(false);
      }, animar ? 950 : 0);
    }

    desenhar(animar: boolean) {
      const L = this.folhas.length;
      this.raiz.classList.toggle('sem-animacao', !animar);
      this.folhas.forEach((folha, k) => {
        const virada = k < this.f;
        folha.classList.toggle('virada', virada);
        folha.style.zIndex = String(virada ? k + 1 : L - k);
        // Só as folhas perto da atual ficam montadas: as fotos distantes nem carregam.
        folha.hidden = k < this.f - 2 || k > this.f + 1;
        const [frente, verso] = folha.children as unknown as HTMLElement[];
        const mostraFrente = k === this.f;
        const mostraVerso = this.duplo && k === this.f - 1;
        const movendo = this.emMovimento.includes(folha);
        frente.inert = !mostraFrente;
        verso.inert = !mostraVerso;
        // Faces que não estão à vista nem virando saem da tela de vez (leitores de tela e verificadores incluídos).
        frente.style.visibility = mostraFrente || movendo ? '' : 'hidden';
        verso.style.visibility = mostraVerso || movendo ? '' : 'hidden';
      });
      this.raiz.classList.toggle('aberto', this.f > 0);
      this.raiz.querySelector<HTMLElement>('.album-fechado')?.toggleAttribute('inert', this.duplo && this.f > 0);
      this.ant.disabled = this.f === 0;
      // Na capa não há para onde voltar: o botão some (sem mexer no layout).
      this.ant.style.visibility = this.f === 0 ? 'hidden' : '';
      this.prox.disabled = this.f === this.maximo;
      const total = this.maximo + 1;
      this.conta.textContent = this.f === 0 ? 'Capa' : `${this.f + 1} de ${total}`;
      if (!animar) requestAnimationFrame(() => this.raiz.classList.remove('sem-animacao'));
    }
  }

  document.querySelectorAll<HTMLElement>('[data-album]').forEach((el) => new Album(el));
</script>

<style>
  .album {
    /* Altura da página: cabe na tela e, no desktop, duas páginas cabem na largura. */
    --pag-h: min(72svh, 760px, calc((100vw - 2 * var(--margem)) * 0.75));
    --pag-w: calc(var(--pag-h) * 2 / 3);
    --curva-pagina: cubic-bezier(0.45, 0.05, 0.25, 1);
    position: relative;
    display: grid;
    gap: var(--s3);
    justify-items: center;
  }
  .album-abertura {
    --pag-h: min(calc(100svh - var(--cab) - 170px), 800px, calc((100vw - 2 * var(--margem)) * 0.75));
  }
  /* Celular: uma página por vez, na largura toda */
  @media (max-width: 899px) {
    .album,
    .album-abertura {
      --pag-h: min(calc(100svh - var(--cab) - 120px), calc((100vw - 2 * var(--margem)) * 1.5));
    }
  }

  /* Sem JavaScript: faixa de páginas com rolagem lateral */
  .album:not(.album-ativo) .album-livro {
    display: flex;
    gap: var(--s2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    max-width: calc(100vw - 2 * var(--margem));
  }
  .album:not(.album-ativo) .album-livro > :global(.pagina) {
    flex: none;
    width: var(--pag-w);
    height: var(--pag-h);
    scroll-snap-align: center;
  }

  .album-janela {
    width: 100%;
    display: grid;
    justify-items: center;
  }
  .album-ativo .album-janela {
    overflow: clip;
    overflow-clip-margin: 40px;
    padding-block: 12px 28px;
  }
  .album-ativo .album-livro {
    position: relative;
    width: var(--pag-w);
    height: var(--pag-h);
    perspective: 2600px;
    cursor: pointer;
    touch-action: pan-y;
  }
  .album-ativo.album-duplo .album-livro {
    width: calc(var(--pag-w) * 2);
  }
  /* Uma página: a folha virada sai pela borda e some, como no livro de verdade */
  .album-ativo:not(.album-duplo) .album-livro {
    overflow: clip;
    overflow-clip-margin: 14px;
  }

  /* Bloco de miolo: as bordas das páginas aparecem do lado do livro */
  .album-ativo .album-livro::before,
  .album-ativo .album-livro::after {
    content: '';
    position: absolute;
    top: 6px;
    bottom: -6px;
    width: var(--pag-w);
    border-radius: 4px 10px 10px 4px;
    background: repeating-linear-gradient(90deg, #e9e1d2 0 2px, #cfc5b3 2px 3px) right / 10px 100% no-repeat, #e9e1d2;
    box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.7);
    pointer-events: none;
  }
  .album-ativo .album-livro::before {
    left: 6px;
  }
  .album-ativo.album-duplo .album-livro::before {
    left: calc(50% + 6px);
  }
  .album-ativo .album-livro::after {
    display: none;
  }
  .album-ativo.album-duplo.aberto .album-livro::after {
    display: block;
    right: calc(50% + 6px);
    border-radius: 10px 4px 4px 10px;
    background-position: left;
  }

  .album-livro :global(.folha) {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--pag-w);
    height: 100%;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.9s var(--curva-pagina);
  }
  .album-duplo .album-livro :global(.folha) {
    left: 50%;
  }
  .album-livro :global(.folha.virada) {
    transform: rotateY(-180deg);
  }
  .album-livro :global(.folha.virando) {
    z-index: 999 !important;
  }
  .album-livro :global(.folha[hidden]) {
    display: none;
  }
  .album-livro :global(.face) {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 3px 10px 10px 3px;
    overflow: hidden;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.65);
  }
  .album-livro :global(.face-verso) {
    transform: rotateY(180deg);
    border-radius: 10px 3px 3px 10px;
  }
  .sem-animacao .album-livro :global(.folha) {
    transition: none;
  }

  /* Sombra da lombada sobre o papel */
  .album-livro :global(.face .pagina-papel)::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(60 40 15 / 0.28), rgb(60 40 15 / 0.06) 7%, transparent 16%);
  }
  .album-livro :global(.face-verso .pagina-papel)::after {
    background: linear-gradient(270deg, rgb(60 40 15 / 0.28), rgb(60 40 15 / 0.06) 7%, transparent 16%);
  }

  /* Texto ao lado do álbum fechado (desktop): ocupa o lugar da página da esquerda */
  .album-fechado {
    width: 100%;
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .album.com-fechado.album-ativo .album-fechado {
      position: absolute;
      z-index: 0;
      top: calc(12px + var(--pag-h) / 2);
      left: 0;
      width: min(calc(50% - var(--s5)), 52ch);
      transform: translateY(-50%);
      transition:
        opacity 0.5s ease,
        visibility 0.5s;
    }
    .album.com-fechado.aberto .album-fechado {
      opacity: 0;
      visibility: hidden;
    }
    .album.com-fechado .album-janela {
      position: relative;
      z-index: 1;
      pointer-events: none;
    }
    .album.com-fechado .album-livro {
      pointer-events: auto;
    }
  }

  .album-controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
  }
  .album-controles[hidden] {
    display: none;
  }
  /* Controles no mesmo estilo do botão secundário: texto com costura por baixo */
  .album-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 6px;
    border: 0;
    background: transparent;
    color: var(--texto);
    font: inherit;
    font-weight: 550;
    text-decoration: underline dashed var(--costura) 2px;
    text-underline-offset: 0.22em;
    cursor: pointer;
    transition: color var(--t-estado);
  }
  .album-btn:hover:not(:disabled) {
    color: var(--link-hover);
    text-decoration-style: solid;
    text-decoration-color: currentColor;
  }
  .album-btn:active:not(:disabled) {
    transform: scale(0.97);
  }
  .album-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .album-conta {
    min-width: 11ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 520px) {
    .album-btn-txt {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .album-livro :global(.folha) {
      transition: none;
    }
  }
</style>
