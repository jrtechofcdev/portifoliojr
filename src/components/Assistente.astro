---
// Assistente de escolha (revisão de 13/11/2026). Uma conversa de duas perguntas, respondidas com
// um toque cada: o que a pessoa quer registrar e para quando. Com a resposta:
//  - as listas marcadas com [data-reordenar] põem primeiro os itens com o mesmo data-tipo
//    (nada some, só muda a ordem; os que combinam ganham a classe .combina);
//  - os links [data-wa-auto] passam a abrir o WhatsApp com a mensagem já escrita.
// A escolha fica no localStorage do visitante (conveniência; sem ele tudo funciona igual).
// Sem JavaScript o assistente não aparece e a lista fica na ordem normal.
// Não se apresenta como IA: é um assistente de escolha, com texto escrito à mão.
// A primeira pergunta se responde tocando numa foto: cada opção mostra a capa do álbum mais
// recente daquele tipo (as miniaturas ficam guardadas no HTML e o script as copia para os botões).
import Simbolo from './Simbolo.astro';
import Foto from './Foto.astro';
import { capaDe, ensaiosPublicaveis } from '../lib/fotos';
import { PRAZOS_ASSISTENTE, TIPOS_ASSISTENTE, site, tipoDoEnsaio } from '../data/site';

interface Props {
  /** "indice": começa recolhido numa linha (página de trabalhos). */
  variante?: 'home' | 'indice';
  /** Para onde rolar depois da resposta. */
  alvo?: string;
}
const { variante = 'home', alvo = '#trabalhos' } = Astro.props;
const ensaios = await ensaiosPublicaveis();
const miniaturas = TIPOS_ASSISTENTE.flatMap((t) => {
  const ensaio = ensaios.find((e) => tipoDoEnsaio(e.data.categoria, e.data.rotulo) === t.id);
  const capa = ensaio ? capaDe(ensaio) : null;
  return capa ? [{ tipo: t.id, capa }] : [];
});
const config = {
  tipos: TIPOS_ASSISTENTE,
  prazos: PRAZOS_ASSISTENTE,
  whatsapp: site.whatsapp,
  alvo,
};
---

<section class:list={['assist wrap', `assist-${variante}`]} id="assistente" aria-label="Assistente de escolha" hidden data-assistente>
  <div class="assist-caixa couro">
    <div class="assist-topo">
      <span class="assist-avatar"><Simbolo tamanho={26} /></span>
      <div class="assist-quem">
        <p class="assist-nome">Assistente <span class="assist-marca">{site.marca}</span></p>
        <p class="assist-sub">Duas perguntas rápidas</p>
      </div>
      <button type="button" class="assist-abrir" data-abrir hidden>Me ajude a escolher</button>
    </div>
    <ol class="assist-conversa" aria-live="polite" data-conversa></ol>
    <div class="assist-opcoes" role="group" aria-label="Respostas" data-opcoes></div>
    <div hidden data-miniaturas>
      {
        miniaturas.map((m) => (
          <span class="assist-mini" data-mini={m.tipo}>
            <Foto slug={m.capa.slug} arquivo={m.capa.arquivo} alt="" sizes="(min-width: 700px) 150px, 44vw" recorte="50% 28%" />
          </span>
        ))
      }
    </div>
  </div>
</section>
<script type="application/json" id="assistente-config" set:html={JSON.stringify(config)} />

<script>
  type Opcao = { id: string; resposta: string; frase: string; titulo?: string };
  type Config = { tipos: Opcao[]; prazos: Opcao[]; whatsapp: string; alvo: string };
  type Escolha = { tipo: string; prazo?: string };

  const raiz = document.querySelector<HTMLElement>('[data-assistente]');
  const fonte = document.getElementById('assistente-config');
  if (raiz && fonte) {
    const cfg: Config = JSON.parse(fonte.textContent || '{}');
    const conversa = raiz.querySelector<HTMLElement>('[data-conversa]')!;
    const opcoes = raiz.querySelector<HTMLElement>('[data-opcoes]')!;
    const abrir = raiz.querySelector<HTMLButtonElement>('[data-abrir]')!;
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CHAVE = 'assistente-escolha';
    const espera = (ms: number) => new Promise((r) => setTimeout(r, calmo ? 0 : ms));

    const ler = (): Escolha | null => {
      try {
        const v = JSON.parse(localStorage.getItem(CHAVE) || 'null');
        return v && cfg.tipos.some((t) => t.id === v.tipo) ? v : null;
      } catch {
        return null;
      }
    };
    const gravar = (e: Escolha | null) => {
      try {
        e ? localStorage.setItem(CHAVE, JSON.stringify(e)) : localStorage.removeItem(CHAVE);
      } catch {}
    };
    const tipoDe = (id?: string) => cfg.tipos.find((t) => t.id === id);
    const prazoDe = (id?: string) => cfg.prazos.find((p) => p.id === id);

    function mensagem(e: Escolha) {
      const t = tipoDe(e.tipo);
      const p = prazoDe(e.prazo);
      if (!t) return '';
      return `Olá, José Renato! Vi seu portfólio e quero ${t.frase}${p ? `, ${p.frase}` : ''}. Pode me contar como funciona?`;
    }
    const linkWa = (msg: string) => `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(msg)}`;

    // Reordena as listas: os que combinam primeiro, na ordem original; os outros depois.
    function ordenar(tipo: string | null, animar: boolean) {
      const aplicar = () => {
        document.querySelectorAll<HTMLElement>('[data-reordenar]').forEach((lista) => {
          const itens = [...lista.querySelectorAll<HTMLElement>(':scope > [data-tipo]')];
          itens.forEach((li, i) => (li.dataset.ordem ??= String(i)));
          itens.sort((a, b) => Number(a.dataset.ordem) - Number(b.dataset.ordem));
          const sim = tipo ? itens.filter((li) => li.dataset.tipo === tipo) : [];
          const nao = itens.filter((li) => !sim.includes(li));
          itens.forEach((li) => li.classList.toggle('combina', sim.includes(li)));
          const divisor = lista.querySelector<HTMLElement>(':scope > [data-divisor]');
          const nova = [...sim, ...(divisor && sim.length && nao.length ? [divisor] : []), ...nao];
          if (divisor) divisor.hidden = !(sim.length && nao.length);
          lista.append(...nova);
          // Fileira deslizante: o encaixe (scroll-snap) seguiria o item antigo; volta para o começo.
          if (lista.classList.contains('trilho')) lista.scrollLeft = 0;
        });
        document.querySelectorAll<HTMLAnchorElement>('a[data-wa-auto]').forEach((a) => {
          a.dataset.waOriginal ??= a.href;
          const e = ler();
          a.href = tipo && e ? linkWa(mensagem(e)) : a.dataset.waOriginal;
        });
      };
      const vt = (document as Document & { startViewTransition?: (f: () => void) => unknown }).startViewTransition;
      if (animar && !calmo && vt) vt.call(document, aplicar);
      else aplicar();
    }

    function balao(texto: string, quem: 'eu' | 'voce' = 'eu') {
      const li = document.createElement('li');
      li.className = `assist-balao assist-${quem}`;
      li.textContent = texto;
      conversa.append(li);
      return li;
    }
    async function digitar(texto: string) {
      const li = document.createElement('li');
      li.className = 'assist-balao assist-eu assist-digitando';
      li.setAttribute('aria-hidden', 'true');
      li.innerHTML = '<span></span><span></span><span></span>';
      conversa.append(li);
      await espera(650);
      li.remove();
      return balao(texto);
    }
    function botoes(lista: { rotulo: string; acao: () => void; classe?: string; href?: string; mini?: string }[]) {
      opcoes.replaceChildren(
        ...lista.map((o, i) => {
          const el = document.createElement(o.href ? 'a' : 'button');
          el.className = o.classe ?? 'chip assist-chip';
          const mini = o.mini ? raiz!.querySelector(`[data-mini="${o.mini}"]`) : null;
          if (mini) {
            // Opção com foto: a capa de um álbum daquele tipo, com o texto por cima.
            const rotulo = document.createElement('span');
            rotulo.className = 'assist-foto-rotulo';
            rotulo.textContent = o.rotulo;
            el.className = 'assist-foto';
            el.append(mini.cloneNode(true), rotulo);
          } else el.textContent = o.rotulo;
          el.style.setProperty('--i', String(i));
          if (o.href) (el as HTMLAnchorElement).href = o.href;
          else (el as HTMLButtonElement).type = 'button';
          el.addEventListener('click', o.acao);
          return el;
        }),
      );
    }
    const limparBotoes = () => opcoes.replaceChildren();
    const irParaLista = () => {
      const destino = document.querySelector(cfg.alvo);
      destino?.scrollIntoView({ behavior: calmo ? 'auto' : 'smooth', block: 'start' });
    };

    async function perguntarTipo() {
      await digitar('O que você quer registrar?');
      botoes([
        ...cfg.tipos.map((t) => ({ rotulo: t.resposta, mini: t.id, acao: () => escolherTipo(t) })),
        { rotulo: 'Quero ver tudo', classe: 'chip assist-chip assist-chip-leve', acao: verTudo },
      ]);
    }
    async function escolherTipo(t: Opcao) {
      limparBotoes();
      balao(t.resposta, 'voce');
      await digitar('Ótimo. E para quando seria?');
      botoes(cfg.prazos.map((p) => ({ rotulo: p.resposta, acao: () => escolherPrazo(t, p) })));
    }
    async function escolherPrazo(t: Opcao, p: Opcao) {
      limparBotoes();
      balao(p.resposta, 'voce');
      const e = { tipo: t.id, prazo: p.id };
      gravar(e);
      ordenar(t.id, true);
      await digitar(`Pronto. Coloquei ${t.titulo} na frente para você. Os outros trabalhos continuam logo depois.`);
      final(e);
    }
    async function verTudo() {
      limparBotoes();
      balao('Quero ver tudo', 'voce');
      gravar(null);
      ordenar(null, true);
      await digitar('Fique à vontade. Todos os álbuns estão logo abaixo, e eu respondo pelo WhatsApp quando quiser.');
      botoes([
        { rotulo: 'Ver os álbuns', classe: 'botao assist-acao', acao: irParaLista },
        { rotulo: 'Recomeçar', classe: 'assist-refazer', acao: recomecar },
      ]);
    }
    function final(e: Escolha) {
      botoes([
        { rotulo: 'Ver o que separei', classe: 'botao assist-acao', acao: irParaLista },
        { rotulo: 'Falar sobre o meu ensaio', classe: 'botao-sec assist-wa', href: linkWa(mensagem(e)), acao: () => {} },
        { rotulo: 'Refazer', classe: 'assist-refazer', acao: recomecar },
      ]);
    }
    async function recomecar() {
      gravar(null);
      ordenar(null, true);
      conversa.replaceChildren();
      limparBotoes();
      balao('Vamos de novo.');
      await perguntarTipo();
    }

    async function iniciar() {
      const salva = ler();
      if (salva) {
        ordenar(salva.tipo, false);
        balao(`Da última vez você procurava ${tipoDe(salva.tipo)!.titulo}. Esses trabalhos já estão na frente.`);
        final(salva);
        return;
      }
      balao(`Oi! Em dois toques eu separo os trabalhos que mais combinam com o que você procura.`);
      await perguntarTipo();
    }

    raiz.hidden = false;
    if (raiz.classList.contains('assist-indice') && !ler()) {
      // Página de trabalhos: começa recolhido, uma linha só.
      abrir.hidden = false;
      raiz.setAttribute('data-recolhido', '');
      abrir.addEventListener('click', () => {
        abrir.hidden = true;
        raiz.removeAttribute('data-recolhido');
        iniciar();
      });
    } else iniciar();

    // Botões fora do assistente (ex.: "Me ajude a escolher" na abertura) levam até ele.
    document.querySelectorAll<HTMLAnchorElement>('a[href="#assistente"]').forEach((a) =>
      a.addEventListener('click', () => {
        if (!abrir.hidden) abrir.click();
      }),
    );
  }
</script>

<style>
  .assist {
    scroll-margin-top: calc(var(--cab) + 16px);
  }
  .assist-home {
    padding-top: var(--s6);
  }
  .assist-indice {
    margin-bottom: var(--s4);
  }
  .assist-caixa {
    display: grid;
    gap: var(--s2);
    max-width: 640px;
    margin-inline: auto;
    padding: var(--s3) var(--s3) var(--s4);
  }
  .assist-topo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .assist-avatar {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 999px;
    background: var(--couro-fundo);
    box-shadow:
      inset 0 0 0 1px rgb(0 252 168 / 0.35),
      0 6px 16px -6px rgb(0 0 0 / 0.6);
  }
  .assist-quem {
    flex: 1;
    min-width: 0;
  }
  .assist-nome {
    font-weight: 650;
    font-size: 15px;
    line-height: 1.25;
  }
  .assist-sub {
    font-size: 13px;
    color: var(--texto-2);
  }
  .assist-abrir {
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: var(--verde);
    color: #0d1512;
    font: inherit;
    font-size: 15px;
    font-weight: 650;
    cursor: pointer;
  }
  .tema-claro .assist-abrir {
    background: var(--verde-escuro);
    color: var(--papel);
  }
  .assist[data-recolhido] .assist-caixa {
    padding-block: var(--s2);
  }
  .assist[data-recolhido] .assist-sub,
  .assist[data-recolhido] .assist-marca {
    display: none;
  }
  .assist-abrir {
    flex: none;
    white-space: nowrap;
  }

  .assist-conversa {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .assist-conversa:empty {
    display: none;
  }
  .assist-conversa :global(.assist-balao) {
    max-width: 88%;
    padding: 12px 16px;
    border-radius: 20px;
    font-size: 16px;
    line-height: 1.45;
    animation: assist-entrar 380ms var(--curva) both;
  }
  .assist-conversa :global(.assist-eu) {
    justify-self: start;
    border-bottom-left-radius: 6px;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  .tema-claro .assist-conversa :global(.assist-eu) {
    background: rgb(255 255 255 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(70 48 20 / 0.08);
  }
  .assist-conversa :global(.assist-voce) {
    justify-self: end;
    border-bottom-right-radius: 6px;
    background: var(--verde);
    color: #0d1512;
    font-weight: 600;
  }
  .tema-claro .assist-conversa :global(.assist-voce) {
    background: var(--verde-escuro);
    color: var(--papel);
  }
  .assist-conversa :global(.assist-digitando) {
    display: flex;
    gap: 5px;
    padding: 16px 18px;
  }
  .assist-conversa :global(.assist-digitando span) {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: currentColor;
    opacity: 0.4;
    animation: assist-ponto 900ms ease-in-out infinite;
  }
  .assist-conversa :global(.assist-digitando span:nth-child(2)) {
    animation-delay: 150ms;
  }
  .assist-conversa :global(.assist-digitando span:nth-child(3)) {
    animation-delay: 300ms;
  }

  .assist-opcoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .assist-opcoes:empty {
    display: none;
  }
  .assist-opcoes > :global(*) {
    animation: assist-entrar 380ms var(--curva) both;
    animation-delay: calc(var(--i, 0) * 60ms);
  }
  .assist-opcoes :global(.assist-chip) {
    min-height: 48px;
  }
  .assist-opcoes :global(.assist-chip-leve) {
    background: transparent;
  }
  /* Opção com foto: a capa de um álbum daquele tipo, com moldura de costura */
  .assist-opcoes :global(.assist-foto) {
    position: relative;
    flex: 1 1 calc(50% - 5px);
    min-width: 0;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
    background: #0b110f;
    color: #f2eee6;
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 12px 22px -14px rgb(0 0 0 / 0.8);
    transition: transform var(--t-estado) var(--curva);
  }
  .assist-opcoes :global(.assist-foto:active) {
    transform: scale(0.96);
  }
  .assist-opcoes :global(.assist-foto .assist-mini) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .assist-opcoes :global(.assist-foto .foto) {
    height: 100%;
    border-radius: 0;
  }
  .assist-opcoes :global(.assist-foto::after) {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(8 12 11 / 0.88) 0%, rgb(8 12 11 / 0.35) 45%, rgb(8 12 11 / 0) 75%);
  }
  .assist-opcoes :global(.assist-foto::before) {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px dashed rgb(242 238 230 / 0.34);
    border-radius: 12px;
    pointer-events: none;
    transition: border-color 300ms;
  }
  .assist-opcoes :global(.assist-foto:hover::before),
  .assist-opcoes :global(.assist-foto:focus-visible::before) {
    border-color: rgb(0 252 168 / 0.8);
  }
  .assist-opcoes :global(.assist-foto-rotulo) {
    position: absolute;
    inset: auto 0 0;
    padding: 0 14px 14px;
    font-size: 14.5px;
    font-weight: 650;
    line-height: 1.2;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }
  @media (min-width: 700px) {
    .assist-opcoes :global(.assist-foto) {
      flex-basis: calc(25% - 8px);
    }
  }
  .assist-opcoes :global(.assist-acao) {
    flex: 1 1 auto;
  }
  .assist-opcoes :global(.assist-refazer) {
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: none;
    color: var(--texto-2);
    font: inherit;
    font-size: 15px;
    text-decoration: underline dashed;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }

  @keyframes assist-entrar {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
  }
  @keyframes assist-ponto {
    50% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .assist-conversa :global(*),
    .assist-opcoes > :global(*) {
      animation: none !important;
    }
  }
</style>
