    filter: drop-shadow(0 1px 0 rgb(0 0 0 / 0.6));
  }
  /* Obturador: lâminas que fecham de fora para dentro, girando, e abrem ao contrário */
  .fab-obturador {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    --obt-iris: 100%;
    background: repeating-conic-gradient(from var(--obt-giro), #0a100e 0deg 52deg, #2b3a34 52deg 60deg);
    -webkit-mask: radial-gradient(circle, transparent calc(var(--obt-iris) * 0.72), #000 calc(var(--obt-iris) * 0.72 + 0.5px));
    mask: radial-gradient(circle, transparent calc(var(--obt-iris) * 0.72), #000 calc(var(--obt-iris) * 0.72 + 0.5px));
  }
  .fab[data-fechado] .fab-obturador {
    animation: iris-fecha 210ms cubic-bezier(0.55, 0, 0.75, 0.2) forwards;
  }
  .fab:not([data-fechado]) .fab-obturador {
    animation: iris-abre 320ms 70ms var(--curva) backwards;
  }
  @keyframes iris-fecha {
    from {
      --obt-iris: 100%;
      --obt-giro: 0deg;
    }
    to {
      --obt-iris: 0%;
      --obt-giro: 70deg;
    }
  }
  @keyframes iris-abre {
    from {
      --obt-iris: 0%;
      --obt-giro: 70deg;
    }
    to {
      --obt-iris: 100%;
      --obt-giro: 0deg;
    }
  }
  /* Clarão do disparo, no instante em que o obturador fecha */
  .fab-clarao {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(circle, #fff 0 22%, rgb(255 255 255 / 0) 72%);
    opacity: 0;
  }
  .fab[data-fechado] .fab-clarao {
    animation: fab-clarao 260ms 150ms ease-out;
  }
  @keyframes fab-clarao {
    30% {
      opacity: 0.9;
    }
  }
  /* "Posso ajudar?": etiqueta de couro ao lado do botão, na primeira visita */
  .fab-chamada {
    padding: 9px 16px;
    border-radius: 999px;
    background: #15211d var(--textura);
    background-blend-mode: overlay;
    color: var(--papel);
