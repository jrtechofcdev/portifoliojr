---
// Botão flutuante de WhatsApp no celular (DESIGN.md §7). Aparece depois da abertura em tela cheia
// e some quando o contato ou o rodapé real estão na tela, para não cobrir os contatos.
// Enquanto a pessoa rola para baixo vendo as fotos, encolhe para só o ícone; ao rolar para cima,
// volta a mostrar o texto.
import { CHAMADA, linkWhatsApp } from '../data/site';
import Icone from './Icone.astro';
interface Props {
  mensagem?: string;
  /** Usa a mensagem montada pelo assistente de escolha, quando houver. */
  auto?: boolean;
}
const { mensagem, auto = false } = Astro.props;
---

<div class="barra-wa" data-barra-wa data-oculta>
  <a class="wa" href={linkWhatsApp(mensagem)} data-wa-auto={auto ? '' : undefined}>
    <Icone nome="whatsapp" tamanho={24} />
    <span>{CHAMADA}</span>
  </a>
</div>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra-wa]');
  if (barra) {
    const alvos = ['.heroi', '[data-rodape]', '[data-contato-ensaio]', '[data-assistente]'].flatMap((s) => [...document.querySelectorAll(s)]);
    const visiveis = new Set<Element>();
    const atualizar = () => barra.toggleAttribute('data-oculta', visiveis.size > 0);
    const io = new IntersectionObserver(
      (es) => {
        es.forEach((e) => (e.isIntersecting ? visiveis.add(e.target) : visiveis.delete(e.target)));
        atualizar();
      },
      { rootMargin: '0px 0px -25% 0px' },
    );
    alvos.forEach((el) => io.observe(el));
    if (!alvos.length) atualizar();

    let ultimo = scrollY;
    addEventListener(
      'scroll',
      () => {
        if (Math.abs(scrollY - ultimo) < 16) return;
        barra.toggleAttribute('data-compacta', scrollY > ultimo);
        ultimo = scrollY;
      },
      { passive: true },
    );
  }
</script>

<style>
  .barra-wa {
    position: fixed;
    right: var(--margem);
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 40;
    transition:
      transform 320ms var(--curva),
      opacity 320ms;
  }
  .barra-wa[data-oculta] {
    transform: translateY(140%) scale(0.8);
    opacity: 0;
    pointer-events: none;
  }
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 22px 0 18px;
    border-radius: 999px;
    background: var(--verde) linear-gradient(115deg, #00fca8 0%, #10efc0 55%, #22d8ff 100%);
    color: #06241b;
    font-weight: 700;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      0 16px 32px -10px rgb(0 0 0 / 0.65);
    transition:
      transform 200ms var(--curva),
      padding 320ms var(--curva),
      gap 320ms var(--curva);
  }
  .wa span {
    max-width: 240px;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 320ms var(--curva),
      opacity 200ms;
  }
  /* Compacta: só o ícone, para não cobrir as fotos (o texto continua no botão para leitor de tela) */
  .barra-wa[data-compacta] .wa {
    gap: 0;
    padding: 0 16px;
  }
  .barra-wa[data-compacta] .wa span {
    max-width: 0;
    opacity: 0;
  }
  .wa:hover {
    color: #0d1512;
  }
  .wa:active {
    transform: scale(0.94);
  }
  .wa:focus-visible {
    outline-color: #f2eee6;
  }
  @media (min-width: 900px) {
    .barra-wa {
      display: none;
    }
  }
</style>
