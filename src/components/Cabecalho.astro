---
import { linkWhatsApp, site } from '../data/site';

const atual = Astro.url.pathname;
const links = [
  { href: '/trabalhos', texto: 'Trabalhos' },
  { href: '/#sobre', texto: 'Sobre' },
  { href: '/#contato', texto: 'Contato' },
];
---

<header class="cabecalho nav">
  <a class="pular botao" href="#conteudo">Pular para o conteúdo</a>
  <div class="barra couro">
    <a class="marca serifa" href="/" aria-label={`${site.marca}, voltar ao início`}>
      {site.marca}<span class="marca-sub">Fotografia</span>
    </a>
    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={atual.startsWith(l.href) && l.href === '/trabalhos' ? 'page' : undefined}>
                {l.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="botao botao-barra" href={linkWhatsApp()}>WhatsApp</a>
    </nav>
    <button class="menu-abrir" type="button" aria-expanded="false" aria-controls="menu-movel">Menu</button>
  </div>
  <div class="menu-movel" id="menu-movel" hidden>
    <div class="wrap menu-topo">
      <span class="marca serifa" aria-hidden="true">{site.marca}</span>
      <button class="menu-fechar" type="button">Fechar</button>
    </div>
    <nav class="wrap menu-lista" aria-label="Principal">
      <ul>
        <li><a class="serifa" href="/">Início</a></li>
        {links.map((l) => <li><a class="serifa" href={l.href}>{l.texto}</a></li>)}
      </ul>
      <a class="botao" href={linkWhatsApp()}>Chamar no WhatsApp</a>
    </nav>
  </div>
</header>

<script>
  const cab = document.querySelector<HTMLElement>('.cabecalho')!;
  const abrir = cab.querySelector<HTMLButtonElement>('.menu-abrir')!;
  const fechar = cab.querySelector<HTMLButtonElement>('.menu-fechar')!;
  const menu = cab.querySelector<HTMLElement>('#menu-movel')!;

  function focaveis() {
    return [...menu.querySelectorAll<HTMLElement>('a, button')];
  }
  function teclas(ev: KeyboardEvent) {
    if (ev.key === 'Escape') return fecharMenu();
    if (ev.key !== 'Tab') return;
    const f = focaveis();
    const primeiro = f[0];
    const ultimo = f[f.length - 1];
    if (ev.shiftKey && document.activeElement === primeiro) {
      ev.preventDefault();
      ultimo.focus();
    } else if (!ev.shiftKey && document.activeElement === ultimo) {
      ev.preventDefault();
      primeiro.focus();
    }
  }
  function abrirMenu() {
    menu.hidden = false;
    abrir.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('menu-aberto');
    document.addEventListener('keydown', teclas);
    fechar.focus();
  }
  function fecharMenu() {
    menu.hidden = true;
    abrir.setAttribute('aria-expanded', 'false');
    document.documentElement.classList.remove('menu-aberto');
    document.removeEventListener('keydown', teclas);
    abrir.focus();
  }
  abrir.addEventListener('click', abrirMenu);
  fechar.addEventListener('click', fecharMenu);
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidden || fecharMenu()));

  // Sobre a foto de abertura a barra fica transparente; ao rolar ganha o couro.
  // Rolando para baixo ela se esconde (mais tela para as fotos no celular); para cima, volta.
  let antes = scrollY;
  let pedido = 0;
  const rolar = () => {
    pedido = 0;
    const y = scrollY;
    cab.toggleAttribute('data-rolado', y > 40);
    if (Math.abs(y - antes) > 6) {
      cab.toggleAttribute('data-escondido', y > antes && y > 240 && !document.documentElement.classList.contains('menu-aberto'));
      antes = y;
    }
  };
  rolar();
  addEventListener('scroll', () => (pedido ||= requestAnimationFrame(rolar)), { passive: true });
  cab.addEventListener('focusin', () => cab.removeAttribute('data-escondido'));

</script>

<style>
  /* Cabeçalho: alça de couro flutuante, com costura */
  .cabecalho {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: calc(10px + env(safe-area-inset-top)) var(--margem) 0;
    transition: transform 320ms var(--curva);
  }
  .cabecalho[data-escondido] {
    transform: translateY(-110%);
  }
  .barra {
    transition:
      background-color 300ms,
      box-shadow 300ms;
  }
  .barra::before {
    transition: opacity 300ms;
  }
  /* Sobre a foto em tela cheia, antes de rolar: sem couro, texto claro */
  :global(body:has(.heroi)) .cabecalho:not([data-rolado]) .barra {
    background: transparent;
    box-shadow: none;
    --texto: #f2eee6;
    --texto-2: #e6e1d7;
    --link-hover: var(--verde);
    --costura: rgb(242 238 230 / 0.7);
    color-scheme: dark;
  }
  :global(body:has(.heroi)) .cabecalho:not([data-rolado]) .barra::before {
    opacity: 0;
  }
  :global(body:has(.heroi)) .cabecalho:not([data-rolado]) .marca {
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.5);
  }
  .barra {
    height: var(--barra);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding-inline: 22px 8px;
    border-radius: 999px;
    transition: box-shadow var(--t-estado);
  }
  .barra::before {
    inset: 5px;
    border-radius: 999px;
    border-width: 1.5px;
  }
  .marca {
    color: var(--texto);
    text-decoration: none;
    font-weight: 620;
    font-size: 21px;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 44px;
    align-items: center;
  }
  .marca:hover {
    color: var(--texto);
  }
  .marca-sub {
    font-family: var(--fonte);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-2);
    text-shadow: none;
  }
  .nav-desktop {
    display: none;
  }
  @media (max-width: 440px) {
    .marca-sub {
      display: none;
    }
  }
  .menu-abrir,
  .menu-fechar {
    min-height: 44px;
    min-width: 44px;
    padding: 0 18px;
    background: transparent;
    border: 1.5px dashed var(--costura);
    border-radius: 999px;
    color: var(--texto);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      color var(--t-estado),
      border-color var(--t-estado);
  }
  .menu-abrir:hover,
  .menu-fechar:hover {
    color: var(--link-hover);
    border-style: solid;
  }
  .menu-abrir:active,
  .menu-fechar:active {
    transform: scale(0.97);
  }
  .menu-movel {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--fundo) var(--textura);
    background-blend-mode: overlay;
    overflow-y: auto;
  }
  .menu-topo {
    height: calc(var(--barra) + 10px);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-lista {
    display: grid;
    gap: var(--s5);
    padding-block: var(--s5);
  }
  .menu-lista ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s1);
  }
  .menu-lista ul a {
    display: block;
    padding-block: var(--s1);
    font-size: var(--display-l);
    line-height: 1.05;
    text-decoration: none;
    color: var(--texto);
    border-bottom: 2px dashed var(--costura-suave);
  }
  .menu-lista ul a:hover {
    color: var(--link-hover);
    font-style: italic;
  }
  .menu-lista .botao {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .menu-abrir,
    .menu-movel {
      display: none !important;
    }
    .nav-desktop {
      display: flex;
      align-items: center;
      gap: var(--s4);
    }
    .nav-desktop ul {
      list-style: none;
      display: flex;
      gap: var(--s3);
      margin: 0;
      padding: 0;
    }
    .nav-desktop ul a {
      color: var(--texto);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-weight: 550;
    }
    .nav-desktop ul a:hover,
    .nav-desktop ul a[aria-current] {
      color: var(--link-hover);
      text-decoration: underline dashed;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.4em;
    }
    .botao-barra {
      min-height: 44px;
    }
  }
</style>
