---
// Capa de álbum de couro: janela com a foto da casinha e o nome gravado em hot stamping
// nas cores da marca. Escala pelo tamanho do próprio contêiner (unidades cqi).
import Foto from './Foto.astro';
import type { FotoEnsaio } from '../lib/fotos';

interface Props {
  foto: FotoEnsaio | null;
  titulo: string;
  /** Linha pequena acima da janela. */
  sobre?: string;
  /** Linha pequena abaixo do título. */
  rodape?: string;
  sizes?: string;
  prioridade?: boolean;
  /** Nível do título: h1 na capa da página, senão um parágrafo. */
  nivel?: 'h1' | 'h2' | 'h3' | 'p';
}
const { foto, titulo, sobre, rodape, sizes = '40vw', prioridade = false, nivel = 'p' } = Astro.props;
const Titulo = nivel;
---

<div class="capa-album">
  <div class="capa-corpo">
  {sobre && <p class="capa-sobre">{sobre}</p>}
  <div class="capa-janela">
    {foto && <Foto slug={foto.slug} arquivo={foto.arquivo} alt={foto.alt} sizes={sizes} prioridade={prioridade} recorte="50% 30%" />}
  </div>
  <Titulo class="capa-titulo">{titulo}</Titulo>
  {rodape && <p class="capa-rodape">{rodape}</p>}
  </div>
</div>

<style>
  /* O contêiner fica por fora: as medidas cqi do corpo valem pela largura da capa */
  .capa-album {
    container-type: inline-size;
    height: 100%;
  }
  .capa-corpo {
    position: relative;
    isolation: isolate;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    gap: 3cqi;
    padding: 11cqi 10cqi 9cqi 14cqi;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.15) 6%, rgb(255 255 255 / 0.04) 7.5%, transparent 9%),
      radial-gradient(120% 90% at 30% 10%, rgb(255 255 255 / 0.06), transparent 60%),
      var(--couro-painel) url('/couro.webp');
    background-blend-mode: normal, normal, overlay;
    color: var(--papel);
    text-align: center;
  }
  /* Costura e o vinco da dobradiça perto da lombada */
  .capa-corpo::before {
    content: '';
    position: absolute;
    inset: 4cqi 4cqi 4cqi 9cqi;
    border: max(1.5px, 0.45cqi) dashed rgb(0 252 168 / 0.6);
    border-radius: 3cqi;
    pointer-events: none;
    z-index: -1;
  }
  .capa-corpo::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 6.5cqi;
    width: 1.2cqi;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.5), rgb(255 255 255 / 0.07));
    pointer-events: none;
  }
  .capa-sobre,
  .capa-rodape {
    font-family: var(--fonte);
    font-size: max(10px, 3.2cqi);
    font-weight: 650;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(242 238 230 / 0.72);
    text-shadow: 0 -1px 0 rgb(0 0 0 / 0.6);
  }
  .capa-janela {
    width: 100%;
    min-height: 0;
    border-radius: 2.5cqi;
    overflow: hidden;
    background: #070b0a;
    /* Janela recortada no couro: borda afundada */
    box-shadow:
      inset 0 0.8cqi 1.6cqi rgb(0 0 0 / 0.8),
      0 0.3cqi 0 rgb(255 255 255 / 0.08);
    padding: 1.2cqi;
  }
  .capa-janela :global(.foto) {
    height: 100%;
    border-radius: 1.6cqi;
  }
  .capa-titulo {
    margin: 0;
    font-family: var(--serifa);
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(18px, 10cqi, 96px);
    font-weight: 500;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
    /* Hot stamping nas cores da marca */
    background: linear-gradient(105deg, #00c98a 0%, #8affd9 32%, #00fca8 50%, #1cdaff 78%, #0fb8d9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 0 rgb(0 0 0 / 0.65));
  }
  @media (forced-colors: active) {
    .capa-titulo {
      color: CanvasText;
      background: none;
    }
  }
</style>
