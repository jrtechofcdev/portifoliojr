---
// Cartão de álbum: a capa em 4:5 com moldura de costura, o nome em serifa e o botão que abre o
// álbum no modo Stories (componente Historias; `historia` é a posição do álbum na lista da página).
// Usado na lista completa (ListaAlbuns) e nas fileiras dos capítulos da home (Capitulos).
import Capa from './Capa.astro';
import Icone from './Icone.astro';
import { fotosDoEnsaio, type Ensaio } from '../lib/fotos';
import { tipoDoEnsaio } from '../data/site';

interface Props {
  ensaio: Ensaio;
  historia: number;
  prioridade?: boolean;
  /** "trilho": cartão menor, para as fileiras que se deslizam. */
  variante?: 'grande' | 'trilho';
  /** O álbum mais recente do portfólio ganha uma etiqueta. */
  recente?: boolean;
  class?: string;
}
const { ensaio: e, historia, prioridade = false, variante = 'grande', recente = false, class: classe } = Astro.props;
const total = fotosDoEnsaio(e).length;
const sizes =
  variante === 'trilho' ? '(min-width: 900px) 30vw, 74vw' : '(min-width: 1100px) 31vw, (min-width: 700px) 46vw, 92vw';
---

<li
  class:list={['cartao', `cartao-${variante}`, classe]}
  data-categoria={e.data.categoria}
  data-tipo={tipoDoEnsaio(e.data.categoria, e.data.rotulo)}
>
  <a class="cartao-link" href={`/trabalhos/${e.id}`}>
    <span class="cartao-foto" style={`view-transition-name: capa-${e.id}`}>
      <Capa
        ensaio={e}
        sizes={sizes}
        recorte={e.data.capa === e.data.abertura.arquivo ? e.data.abertura.foco : '50% 30%'}
        prioridade={prioridade}
      />
    </span>
    <span class="reflexo" aria-hidden="true" />
    {
      recente && (
        <span class="cartao-recente">
          <Icone nome="brilho" tamanho={13} traco={2} />
          Mais recente
        </span>
      )
    }
    <span class="cartao-texto">
      <span class="cartao-rotulo">{e.data.rotulo}</span>
      <span class="cartao-nome serifa">{e.data.nome}</span>
      <span class="cartao-ficha">
        {[e.data.cidade, e.data.data.slice(0, 4), `${total} fotos`].filter(Boolean).join(' · ')}
      </span>
    </span>
  </a>
  <button type="button" class="cartao-play" data-historia={historia} aria-label={`Assistir as fotos de ${e.data.nome} em tela cheia`}>
    <Icone nome="play" tamanho={18} />
  </button>
</li>

<style>
  .cartao {
    position: relative;
    min-width: 0;
    /* o nome acompanha a largura do cartão (unidade cqi), seja ele grande ou de fileira */
    container-type: inline-size;
  }
  .cartao-link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--raio-g);
    overflow: hidden;
    isolation: isolate;
    color: #f2eee6;
    text-decoration: none;
    background: #0b110f;
    box-shadow: var(--sombra);
    transition: transform 250ms var(--curva);
  }
  .cartao-link:active {
    transform: scale(0.98);
  }
  .cartao-link:hover {
    color: #f2eee6;
  }
  .cartao-foto {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .cartao-foto :global(.foto) {
    height: 100%;
    border-radius: 0;
  }
  .cartao-foto :global(img) {
    transition: transform 900ms var(--curva);
  }
  .cartao-link:hover .cartao-foto :global(img) {
    transform: scale(1.06);
  }
  /* Escurece só embaixo, onde fica o nome */
  .cartao-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(8 12 11 / 0.86) 0%, rgb(8 12 11 / 0.3) 30%, rgb(8 12 11 / 0) 52%);
  }
  /* Moldura de álbum: costura fina por dentro da borda do cartão */
  .cartao-link::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 1;
    border: 1.5px dashed rgb(242 238 230 / 0.32);
    border-radius: calc(var(--raio-g) - 10px);
    pointer-events: none;
    transition: border-color 400ms;
  }
  .cartao-link:hover::before,
  .combina .cartao-link::before {
    border-color: rgb(0 252 168 / 0.7);
  }
  .cartao-texto {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 8px;
    padding: var(--s4) var(--s4) calc(var(--s4) + 4px);
  }
  .cartao-rotulo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #dcd7cd;
  }
  .cartao-rotulo::before {
    content: '';
    width: 22px;
    border-top: 1.5px dashed var(--verde);
  }
  .cartao-nome {
    font-size: clamp(34px, 9.4vw, 54px);
    font-size: clamp(22px, 10.4cqi, 54px);
    font-weight: 420;
    line-height: 0.98;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.5);
  }
  .cartao-ficha {
    font-size: 14px;
    font-weight: 500;
    color: #d6d1c7;
  }
  .cartao-link:focus-visible {
    outline-offset: 4px;
  }
  /* Botão de assistir: pequeno, de vidro escuro, fora do link (não aninhado) */
  .cartao-play {
    position: absolute;
    top: 22px;
    right: 22px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(242 238 230 / 0.35);
    border-radius: 999px;
    background: rgb(8 12 11 / 0.42);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #f2eee6;
    cursor: pointer;
    transition:
      transform 200ms var(--curva),
      background-color 200ms,
      color 200ms;
  }
  /* Etiqueta do álbum mais recente: vidro escuro, no canto oposto ao botão de assistir */
  .cartao-recente {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px 6px 10px;
    border: 1px solid rgb(242 238 230 / 0.3);
    border-radius: 999px;
    background: rgb(8 12 11 / 0.46);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #f2eee6;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cartao-recente :global(svg) {
    color: var(--verde);
  }
  .cartao-play:hover {
    background: var(--verde);
    border-color: transparent;
    color: #0d1512;
  }
  .cartao-play:active {
    transform: scale(0.9);
  }

  /* Cartão das fileiras: mais estreito, deixa o próximo aparecer na beirada */
  .cartao-trilho {
    width: min(72vw, 320px);
  }
  .cartao-trilho .cartao-texto {
    gap: 6px;
    padding: var(--s3) var(--s3) calc(var(--s3) + 4px);
  }
  .cartao-trilho .cartao-nome {
    font-size: clamp(27px, 7.2vw, 34px);
    font-size: clamp(22px, 10.4cqi, 42px);
    line-height: 1.02;
  }
  .cartao-trilho .cartao-rotulo {
    font-size: 10.5px;
  }
  .cartao-trilho .cartao-ficha {
    font-size: 13px;
  }
  .cartao-trilho .cartao-play {
    top: 20px;
    right: 20px;
  }
</style>
