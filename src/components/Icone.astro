const CHEIO = {
  play: 'M8 5.3v13.4a.9.9 0 0 0 1.4.8l10.4-6.7a.9.9 0 0 0 0-1.6L9.4 4.5A.9.9 0 0 0 8 5.3Z',
  pausa:
    'M7.5 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1ZM14.5 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z',
  instagram: 'M17.2 5.8a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
} as const;

// Desenhado numa grade de 32 px; entra reduzido para a grade de 24.
const WHATSAPP =
  'M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6c-2 0-3.9-.5-5.5-1.5l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.8 5.1 2.2.9 3 1 4.1.8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.3Z';

export type NomeIcone = keyof typeof TRACO | keyof typeof CHEIO | 'whatsapp';

interface Props {
  nome: NomeIcone;
  tamanho?: number;
  /** Espessura do traço na grade de 24 px. */
  traco?: number;
  class?: string;
  /** Nome para leitor de tela; sem ele o ícone é decorativo. */
  rotulo?: string;
  [atributo: `data-${string}`]: unknown;
}
// `resto` leva o atributo de escopo do componente pai, para que o estilo dele alcance o ícone.
const { nome, tamanho = 24, traco = 1.6, class: classe, rotulo, ...resto } = Astro.props;
const linha = (TRACO as Record<string, string>)[nome];
const massa = (CHEIO as Record<string, string>)[nome];
---

<svg
  class:list={['icone', classe]}
  viewBox="0 0 24 24"
  width={tamanho}
  height={tamanho}
  fill="none"
  stroke="currentColor"
  stroke-width={traco}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={rotulo ? 'img' : undefined}
  aria-label={rotulo}
  aria-hidden={rotulo ? undefined : 'true'}
  {...resto}
>
  {linha && <path d={linha} />}
  {massa && <path d={massa} fill="currentColor" stroke="none" />}
  {nome === 'whatsapp' && <path d={WHATSAPP} transform="scale(.75)" fill="currentColor" stroke="none" />}
</svg>

<style>
  .icone {
    display: block;
    flex: none;
  }
</style>
