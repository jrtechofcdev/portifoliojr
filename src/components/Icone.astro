---
// Ícones do site (edição de luxo, 13/11/2026): um conjunto só, desenhado na mesma grade de 24 px,
// traço fino de ponta redonda, na cor do texto ao redor (currentColor). Os de marca (WhatsApp,
// Instagram) seguem o mesmo peso. Decorativo por padrão; com `rotulo` vira imagem com nome.
const TRACO = {
  'seta-direita': 'M4.5 12h15M13.5 6l6 6-6 6',
  'seta-esquerda': 'M19.5 12h-15M10.5 6l-6 6 6 6',
  'seta-baixo': 'M12 4.5v15M6 13.5l6 6 6-6',
  'seta-cima': 'M12 19.5v-15M6 10.5l6-6 6 6',
  'seta-fora': 'M7 17 17 7M9 7h8v8',
  fechar: 'M6 6l12 12M18 6 6 18',
  menu: 'M4 8.5h16M10 15.5h10',
  email: 'M5.5 5.5h13a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2ZM4 7.5l8 6 8-6',
  instagram:
    'M8 3.5h8A4.5 4.5 0 0 1 20.5 8v8a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5ZM12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Z',
  local: 'M12 21c-1-.9-6.5-5.9-6.5-10.5a6.5 6.5 0 0 1 13 0C18.5 15.1 13 20.1 12 21ZM12 8a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z',
  conversa:
    'M7 4.5h10A2.5 2.5 0 0 1 19.5 7v6a2.5 2.5 0 0 1-2.5 2.5h-5.5l-4 3.5v-3.5H7A2.5 2.5 0 0 1 4.5 13V7A2.5 2.5 0 0 1 7 4.5ZM8.5 8.7h7M8.5 11.7h4.5',
  calendario:
    'M6.5 5.5h11A2.5 2.5 0 0 1 20 8v9.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5V8a2.5 2.5 0 0 1 2.5-2.5ZM4 10.5h16M8.5 3.5v4M15.5 3.5v4M8.5 14.5h3',
  camera:
    'M9.2 5.5 8 7.5H6A2.5 2.5 0 0 0 3.5 10v7A2.5 2.5 0 0 0 6 19.5h12a2.5 2.5 0 0 0 2.5-2.5v-7A2.5 2.5 0 0 0 18 7.5h-2l-1.2-2a1 1 0 0 0-.9-.5h-3.8a1 1 0 0 0-.9.5ZM12 10a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z',
  edicao:
    'M4.5 7H12M16 7h3.5M4.5 12H7M11 12h8.5M4.5 17H13M17 17h2.5M14 5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM9 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM15 15a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z',
  album: 'M7 3.5h10a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2ZM8.5 3.5v17M11.5 8H16v4h-4.5Z',
  brilho: 'M12 4c.8 4.8 3.2 7.2 8 8-4.8.8-7.2 3.2-8 8-.8-4.8-3.2-7.2-8-8 4.8-.8 7.2-3.2 8-8Z',
  grade: 'M5 5h5.5v5.5H5ZM13.5 5H19v5.5h-5.5ZM5 13.5h5.5V19H5ZM13.5 13.5H19V19h-5.5Z',
  pessoa: 'M12 4.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7ZM5 20c.5-3.6 3.3-6 7-6s6.5 2.4 7 6',
  coracao: 'M12 20c-1.2-.8-7.5-5-7.5-10.2A4.2 4.2 0 0 1 12 7.2a4.2 4.2 0 0 1 7.5 2.6C19.5 15 13.2 19.2 12 20Z',
  broto: 'M12 20.5V11M12 13c0-3.3 2.2-5.5 6.5-5.5 0 3.5-2.2 5.5-6.5 5.5ZM12 15.5c0-2.8-1.9-4.7-5.5-4.7 0 3 1.9 4.7 5.5 4.7Z',
  bolo: 'M4.5 20h15M6.5 20v-6.5A1.5 1.5 0 0 1 8 12h8a1.5 1.5 0 0 1 1.5 1.5V20M6.5 16h11M12 12V8.5M12 4.2c.9 1 .9 2 0 2.8-.9-.8-.9-1.8 0-2.8Z',
  coroa: 'M4.5 17.5 5.5 8l4 4 2.5-6 2.5 6 4-4 1 9.5ZM5 20.5h14',
