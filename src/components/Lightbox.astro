---
// Visualização ampliada (DESIGN.md §6): <dialog> nativo, setas, Esc, ← →, deslizar, contador,
// foco preso pelo próprio showModal() e devolvido à miniatura ao fechar.
interface Props {
  nome: string;
}
const { nome } = Astro.props;
---

<dialog class="lightbox" aria-label={`Fotos de ${nome}`}>
  <div class="lb-palco">
    <picture>
      <source type="image/avif" />
      <source type="image/webp" />
      <img alt="" sizes="100vw" decoding="async" />
    </picture>
  </div>
  <div class="lb-controles">
    <button type="button" class="lb-botao" data-acao="anterior">Anterior</button>
    <p class="lb-contador" aria-live="polite"></p>
    <button type="button" class="lb-botao" data-acao="proxima">Próxima</button>
  </div>
  <button type="button" class="lb-botao lb-fechar" data-acao="fechar">Fechar</button>
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const itens = [...document.querySelectorAll<HTMLAnchorElement>('[data-galeria] a.item')];
  if (dialogo && itens.length) {
    const [avif, webp] = dialogo.querySelectorAll('source');
    const img = dialogo.querySelector('img')!;
    const contador = dialogo.querySelector('.lb-contador')!;
    let atual = 0;
    let origem: HTMLElement | null = null;

    function mostrar(i: number) {
      const lado = i < atual ? 'esq' : 'dir';
      img.dataset.lado = lado;
      img.classList.remove('lb-troca');
      void img.offsetWidth;
      img.classList.add('lb-troca');
      atual = (i + itens.length) % itens.length;
      const a = itens[atual];
      avif.srcset = a.dataset.avif!;
      webp.srcset = a.dataset.webp!;
      img.srcset = a.dataset.webp!;
      img.src = a.href;
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      img.alt = a.querySelector('img')?.alt ?? '';
      contador.textContent = `${atual + 1} / ${itens.length}`;
    }

    itens.forEach((a, i) =>
      a.addEventListener('click', (ev) => {
        if (ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
        ev.preventDefault();
        origem = a;
        mostrar(i);
        dialogo.showModal();
      }),
    );

    dialogo.addEventListener('click', (ev) => {
      const alvo = ev.target as HTMLElement;
      const acao = alvo.closest<HTMLElement>('[data-acao]')?.dataset.acao;
      if (acao === 'anterior') mostrar(atual - 1);
      else if (acao === 'proxima') mostrar(atual + 1);
      else if (acao === 'fechar' || alvo === dialogo) dialogo.close();
    });
    dialogo.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowLeft') mostrar(atual - 1);
      else if (ev.key === 'ArrowRight') mostrar(atual + 1);
    });
    dialogo.addEventListener('close', () => origem?.focus());

    let x0: number | null = null;
    const palco = dialogo.querySelector<HTMLElement>('.lb-palco')!;
    palco.addEventListener('pointerdown', (ev) => (x0 = ev.clientX));
    palco.addEventListener('pointerup', (ev) => {
      if (x0 === null) return;
      const dx = ev.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) mostrar(atual + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(11 17 15 / 0.97);
    color: #f2eee6;
    --foco: #00fca8;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    animation: lb-entrar var(--t-dialogo) ease-out;
  }
  .lightbox::backdrop {
    background: rgb(11 17 15 / 0.97);
  }
  .lb-palco {
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 56px var(--s2) 0;
    touch-action: pan-y;
  }
  .lb-palco picture,
  .lb-palco img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-palco picture {
    display: contents;
  }
  .lb-palco img {
    border-radius: 14px;
    max-height: calc(100dvh - 56px - 72px);
  }
  .lb-controles {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--margem);
  }
  .lb-contador {
    font-size: var(--legenda);
    font-weight: 500;
    color: #a8a39a;
    font-variant-numeric: tabular-nums;
  }
  .lb-botao {
    min-height: 44px;
    min-width: 44px;
    padding: 0 20px;
    background: transparent;
    border: 1.5px dashed rgb(0 252 168 / 0.55);
    border-radius: 999px;
    color: #f2eee6;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: color 180ms, border-color 180ms;
  }
  .lb-botao:hover {
    color: #00fca8;
    border-style: solid;
  }
  .lb-botao:active {
    transform: scale(0.97);
  }
  .lb-botao:focus-visible {
    outline: 2px solid #00fca8;
    outline-offset: 2px;
  }
  .lb-fechar {
    position: absolute;
    top: 10px;
    right: var(--margem);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lb-palco img.lb-troca {
      animation: lb-deslizar 320ms var(--curva);
    }
    .lb-palco img.lb-troca[data-lado='esq'] {
      --de: -40px;
    }
  }
  @keyframes lb-deslizar {
    from {
      opacity: 0.2;
      transform: translateX(var(--de, 40px)) scale(0.97);
    }
  }
  @keyframes lb-entrar {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }
</style>
