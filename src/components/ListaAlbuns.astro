---
// Lista completa de álbuns em cartões grandes de foto (um por tela no celular), com filtro pelos
// mesmos tipos dos capítulos da home (CAPITULOS, tipoDoEnsaio). Usada na página de trabalhos.
// Sem JS o filtro fica escondido e todos os álbuns aparecem.
// O endereço guarda o filtro (?c=casal); os endereços antigos por categoria (?c=casais) continuam valendo.
import CartaoAlbum from './CartaoAlbum.astro';
import { maisRecente, type Ensaio } from '../lib/fotos';
import { CAPITULOS, TIPOS_ASSISTENTE, tipoDoEnsaio } from '../data/site';

interface Props {
  ensaios: Ensaio[];
  /** Primeiro cartão com prioridade de carregamento (página sem abertura em tela cheia). */
  prioridade?: boolean;
}
const { ensaios, prioridade = false } = Astro.props;
const novo = maisRecente(ensaios);
const contagem = new Map<string, number>();
for (const e of ensaios) {
  const t = tipoDoEnsaio(e.data.categoria, e.data.rotulo);
  contagem.set(t, (contagem.get(t) ?? 0) + 1);
}
const filtros = TIPOS_ASSISTENTE.map((t) => t.id).filter((t) => contagem.has(t));
---

<div class="lista-albuns" data-lista-albuns>
  {
    filtros.length > 1 && (
      <div class="filtro trilho" role="group" aria-label="Filtrar por categoria" hidden data-filtro>
        <button type="button" class="chip" aria-pressed="true" data-c="">
          Todos <span class="chip-conta">{ensaios.length}</span>
        </button>
        {filtros.map((c) => (
          <button type="button" class="chip" aria-pressed="false" data-c={c}>
            {CAPITULOS[c].nome} <span class="chip-conta">{contagem.get(c)}</span>
          </button>
        ))}
      </div>
    )
  }

  <ul class="cartoes wrap" data-reordenar>
    <li class="cartoes-divisor" data-divisor hidden>
      <span class="sobretitulo">Mais trabalhos</span>
    </li>
    {ensaios.map((e, i) => <CartaoAlbum ensaio={e} historia={i} prioridade={prioridade && i === 0} recente={e.id === novo?.id} class="surge" />)}
  </ul>
  <p class="wrap texto" hidden data-vazio>Nenhum trabalho nesta categoria.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lista-albuns]').forEach((raiz) => {
    const filtro = raiz.querySelector<HTMLElement>('[data-filtro]');
    if (!filtro) return;
    const botoes = [...filtro.querySelectorAll<HTMLButtonElement>('button')];
    const itens = [...raiz.querySelectorAll<HTMLElement>('.cartao[data-tipo]')];
    const vazio = raiz.querySelector<HTMLElement>('[data-vazio]')!;
    const divisor = raiz.querySelector<HTMLElement>('[data-divisor]');
    // Endereços antigos, de quando o filtro era por categoria
    const antigos: Record<string, string> = { ensaios: 'ensaio', casais: 'casal', eventos: 'evento' };
    function aplicar(c: string) {
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.c === c)));
      let n = 0;
      itens.forEach((li) => {
        const ok = !c || li.dataset.tipo === c;
        li.hidden = !ok;
        if (ok) n++;
      });
      vazio.hidden = n > 0;
      // "Mais trabalhos" (assistente) só faz sentido com todos os álbuns na tela
      if (divisor) divisor.classList.toggle('filtrado', !!c);
      const url = new URL(location.href);
      c ? url.searchParams.set('c', c) : url.searchParams.delete('c');
      history.replaceState(null, '', url);
    }
    botoes.forEach((b) =>
      b.addEventListener('click', () => {
        aplicar(b.dataset.c ?? '');
        b.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      }),
    );
    filtro.hidden = false;
    const pedido = new URLSearchParams(location.search).get('c') ?? '';
    const inicial = antigos[pedido] ?? pedido;
    if (inicial && botoes.some((b) => b.dataset.c === inicial)) aplicar(inicial);
  });
</script>

<style>
  .filtro {
    padding-block: 10px;
    margin-bottom: var(--s2);
  }
  .cartoes {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--s3);
  }
  .cartoes-divisor {
    grid-column: 1 / -1;
    padding-top: var(--s3);
  }
  .cartoes-divisor.filtrado {
    display: none;
  }
  .chip-conta {
    margin-left: 8px;
    font-size: 12.5px;
    font-weight: 600;
    opacity: 0.7;
  }
  @media (min-width: 700px) {
    .cartoes {
      grid-template-columns: repeat(2, 1fr);
    }
    .cartoes > :global(.cartao:nth-child(even of .cartao:not([hidden]))) {
      margin-top: var(--s6);
    }
  }
  @media (min-width: 1100px) {
    .cartoes {
      grid-template-columns: repeat(3, 1fr);
    }
    .cartoes > :global(.cartao:nth-child(even of .cartao:not([hidden]))) {
      margin-top: 0;
    }
    .cartoes > :global(.cartao:nth-child(3n + 2 of .cartao:not([hidden]))) {
      margin-top: var(--s6);
    }
  }
</style>
