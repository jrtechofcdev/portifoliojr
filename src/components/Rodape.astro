---
// Rodapé compacto (plano de melhorias de 13/11/2026). Fecha a página depois da chamada final, sem
// repetir o texto dela: marca, contato, atendimento e navegação. Colunas no computador, blocos
// empilhados no celular (atendimento e navegação lado a lado). Uma linha fina e um couro um pouco
// mais escuro o separam da faixa de cima.
import { linkEmail, linkInstagram, linkWhatsApp, site } from '../data/site';
import Simbolo from './Simbolo.astro';
import Icone, { type NomeIcone } from './Icone.astro';

const ano = new Date().getFullYear();

const contatos: { icone: NomeIcone; rotulo: string; valor: string; href: string }[] = [
  { icone: 'whatsapp', rotulo: 'WhatsApp', valor: site.whatsappExibicao, href: linkWhatsApp() },
  { icone: 'email', rotulo: 'E-mail', valor: site.email, href: linkEmail },
  { icone: 'instagram', rotulo: 'Instagram', valor: `@${site.instagram}`, href: linkInstagram },
];
const paginas = [
  { href: '/', texto: 'Início' },
  { href: '/trabalhos', texto: 'Todos os álbuns' },
  { href: '/#servicos', texto: 'Serviços' },
  { href: '/#sobre', texto: 'Sobre' },
  { href: '/#contato', texto: 'Contato' },
];
---

<footer class="rodape" data-rodape>
  <div class="wrap rodape-grade">
    <div class="rodape-marca">
      <a class="rodape-logo" href="/">
        <Simbolo tamanho={30} />
        <span class="serifa">{site.marca}</span>
      </a>
      <p class="rodape-slogan">{site.slogan}</p>
      <p class="rodape-resumo">Fotografia de ensaios, aniversários, festas de 15 anos e eventos em Bacabal e Imperatriz, MA.</p>
    </div>

    <div class="rodape-bloco rodape-fale">
      <h2 class="rodape-titulo">Fale comigo</h2>
      <ul class="rodape-lista">
        {
          contatos.map((c) => (
            <li>
              <a href={c.href}>
                <Icone nome={c.icone} tamanho={18} />
                <span class="visualmente-oculto">{c.rotulo}: </span>
                {c.valor}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rodape-bloco">
      <h2 class="rodape-titulo">Atendimento</h2>
      <p class="rodape-texto">Bacabal e Imperatriz, Maranhão. Outras cidades, sob consulta.</p>
    </div>

    <nav class="rodape-bloco" aria-label="Rodapé">
      <h2 class="rodape-titulo">Navegue</h2>
      <ul class="rodape-lista">
        {
          paginas.map((p) => (
            <li>
              <a href={p.href}>{p.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap rodape-fim">
    <p class="rodape-direitos">
      © {ano} {site.marca} · {site.fotografo}. Todos os direitos reservados. Fotografias reais, publicadas com
      autorização. Proibida a cópia ou reprodução sem permissão.
    </p>
    <ul class="rodape-legal">
      <li><a href="/privacidade">Privacidade</a></li>
      <li><a href="/direitos-autorais">Direitos autorais</a></li>
    </ul>
    <a class="rodape-topo" href="#conteudo">
      <Icone nome="seta-cima" tamanho={16} />
      Voltar ao topo
    </a>
  </div>
</footer>

<style>
  .rodape {
    position: relative;
    background: var(--couro-fundo) var(--textura);
    background-blend-mode: overlay;
    border-top: 1px solid rgb(242 238 230 / 0.1);
    color: var(--papel);
    padding-block: var(--s6) calc(var(--s3) + env(safe-area-inset-bottom));
    color-scheme: dark;
    --fundo: var(--couro-fundo);
    --texto: var(--papel);
    --link: var(--papel);
    --link-hover: var(--verde);
    --texto-2: #b9b4aa;
    --destaque: var(--verde);
    --foco: var(--verde);
    --relevo: 0 -1px 0 rgb(0 0 0 / 0.55);
  }

  .rodape-grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s5) var(--s3);
  }
  .rodape-marca,
  .rodape-fale {
    grid-column: 1 / -1;
  }
  .rodape-marca {
    display: grid;
    gap: 10px;
    justify-items: start;
    align-content: start;
  }
  .rodape-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--texto);
    text-decoration: none;
    font-size: 28px;
    font-weight: 420;
    letter-spacing: -0.015em;
  }
  .rodape-logo:hover {
    color: var(--texto);
  }
  .rodape-slogan {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--verde);
  }
  .rodape-resumo {
    max-width: 36ch;
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--texto-2);
  }

  .rodape-bloco {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .rodape-titulo {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--texto-2);
  }
  .rodape-lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rodape-lista a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--texto);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .rodape-lista a :global(svg) {
    flex: none;
    color: var(--verde);
  }
  .rodape-lista a:hover {
    color: var(--verde);
    text-decoration: underline dashed;
    text-underline-offset: 0.34em;
  }
  .rodape-texto {
    max-width: 30ch;
    font-size: 15.5px;
    line-height: 1.55;
  }

  .rodape-fim {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s1) var(--s3);
    margin-top: var(--s5);
    padding-top: var(--s3);
    border-top: 1px solid rgb(242 238 230 / 0.1);
  }
  .rodape-direitos {
    max-width: 60ch;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--texto-2);
  }
  .rodape-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rodape-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 550;
    color: var(--texto-2);
    text-decoration: underline dashed;
    text-underline-offset: 0.34em;
  }
  .rodape-legal a:hover {
    color: var(--verde);
  }
  .rodape-topo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 550;
    color: var(--texto-2);
    text-decoration: none;
  }
  .rodape-topo:hover {
    color: var(--verde);
  }

  @media (min-width: 900px) {
    .rodape-grade {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 0.8fr);
      gap: var(--s5);
    }
    .rodape-marca,
    .rodape-fale {
      grid-column: auto;
    }
  }
</style>
