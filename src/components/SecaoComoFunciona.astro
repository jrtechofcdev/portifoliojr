---
// Como funciona: linha do tempo costurada, com um ícone por etapa (página /como-funciona).
// No celular, compacta (ícone menor, texto ao lado); a partir de 640 px, duas colunas; no
// computador, cinco. O texto das etapas vem de PASSOS (site.ts), o mesmo do assistente.
import Icone, { type NomeIcone } from './Icone.astro';
import { PASSOS } from '../data/site';
---

<section class="secao como" aria-labelledby="como-titulo">
  <div class="wrap secao-topo surge">
    <p class="sobretitulo">Como funciona</p>
    <h1 class="display-l" id="como-titulo">Do planejamento à <em>entrega</em></h1>
    <p class="lead">Um processo simples, com os detalhes alinhados desde o primeiro contato.</p>
  </div>
  <ol class="wrap passos">
    {
      PASSOS.map((p, i) => (
        <li class="passo surge">
          <span class="passo-topo">
            <span class="medalha">
              <Icone nome={p.icone as NomeIcone} tamanho={22} />
            </span>
            <span class="passo-fio" aria-hidden="true" />
          </span>
          <div class="passo-texto">
            <p class="passo-num">Etapa {i + 1}</p>
            <h2 class="titulo">{p.nome}</h2>
            <p class="passo-descricao">{p.texto}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .secao-topo {
    justify-items: start;
  }
  .passos {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--s3);
  }
  .passo {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    align-content: start;
  }
  .passo .medalha {
    width: 40px;
    height: 40px;
  }
  .passo-topo {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .passo-fio {
    display: none;
  }
  .passo:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 48px;
    bottom: calc(var(--s3) * -1 + 6px);
    border-left: 1.5px dashed var(--costura-suave);
  }
  .passo-texto {
    display: grid;
    gap: 2px;
  }
  .passo-num {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--destaque);
  }
  .passo .titulo {
    font-size: clamp(22px, 5.6vw, 28px);
  }
  .passo-descricao {
    margin-top: 2px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--texto-2);
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .passos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s4) var(--s5);
    }
    .passo::before {
      display: none;
    }
  }
  @media (min-width: 1000px) {
    .passos {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s4);
    }
    .passo {
      grid-template-columns: minmax(0, 1fr);
    }
    .passo .medalha {
      width: 48px;
      height: 48px;
    }
    .passo::before {
      display: none;
    }
    .passo-fio {
      display: block;
      flex: 1;
      border-top: 1.5px dashed var(--costura-suave);
    }
    .passo:last-child .passo-fio {
      display: none;
    }
  }
</style>
