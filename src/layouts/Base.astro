---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Abertura from '../components/Abertura.astro';
import AssistenteChat from '../components/AssistenteChat.astro';
import { PREVIA } from '../lib/fotos';
import { site } from '../data/site';

interface Props {
  titulo: string;
  descricao: string;
  tema?: 'claro' | 'escuro';
  /** Caminho da imagem 1200x630 (Open Graph), quando a foto está autorizada. */
  imagem?: string;
  /** Prévia de compartilhamento (WhatsApp, redes): título, descrição e texto da imagem próprios.
   *  Sem isso, a prévia usa o título e a descrição da página. */
  social?: { titulo?: string; descricao?: string; imagemAlt?: string };
  jsonld?: Record<string, unknown>;
  /** Página com a capa de couro na abertura (só a home). */
  abertura?: boolean;
}

const { titulo, descricao, tema = 'escuro', imagem, social, jsonld, abertura = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemAbs = imagem ? new URL(imagem, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR" data-type="service">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    {
      abertura && (
        <script is:inline>
          try {
            if (sessionStorage.getItem('capa-vista')) document.documentElement.classList.add('ja-abriu');
            else sessionStorage.setItem('capa-vista', '1');
          } catch (e) {}
        </script>
      )
    }
    <link rel="canonical" href={canonica} />
    {PREVIA ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="noai, noimageai" />}
    <meta name="author" content={site.fotografo} />
    <meta name="copyright" content={`© ${site.marca} · ${site.fotografo}. Todos os direitos reservados.`} />
    <meta name="theme-color" content={tema === 'claro' ? '#EFE6D6' : '#121B18'} />
    <!-- Ícone: álbum de capa dura em perspectiva (scripts/icones.mjs). O SVG vem por último: é o preferido. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={social?.titulo ?? titulo} />
    <meta property="og:description" content={social?.descricao ?? descricao} />
    <meta property="og:url" content={canonica} />
    {imagemAbs && <meta property="og:image" content={imagemAbs} />}
    {imagemAbs && <meta property="og:image:width" content="1200" />}
    {imagemAbs && <meta property="og:image:height" content="630" />}
    {imagemAbs && <meta property="og:image:type" content="image/jpeg" />}
    {imagemAbs && social?.imagemAlt && <meta property="og:image:alt" content={social.imagemAlt} />}
    <meta name="twitter:card" content={imagemAbs ? 'summary_large_image' : 'summary'} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body class:list={{ 'tema-claro': tema === 'claro' }}>
    {abertura && <Abertura />}
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <slot name="depois" />
    <Rodape />
    <AssistenteChat />
    <p class="aviso-protecao" data-aviso-protecao role="status" aria-live="polite"></p>
    <script>
      // Disparo de câmera nos botões (14/11/2026): ao tocar, o botão afunda, um clarão cruza o couro
      // e a peça se fecha e abre como um obturador. Não atrasa a navegação (CSS em global.css).
      const DISPARO = '.botao, .botao-fantasma, .chip, .chat-foto, [data-disparo]';
      document.addEventListener(
        'pointerdown',
        (e) => {
          const b = e.target instanceof Element ? e.target.closest<HTMLElement>(DISPARO) : null;
          if (!b) return;
          const r = b.getBoundingClientRect();
          b.style.setProperty('--px', `${e.clientX - r.left}px`);
          b.style.setProperty('--py', `${e.clientY - r.top}px`);
          b.classList.remove('disparo');
          void b.offsetWidth;
          b.classList.add('disparo');
        },
        { passive: true },
      );
      document.addEventListener('animationend', (e) => {
        if (e.animationName === 'disparo' && e.target instanceof Element) e.target.classList.remove('disparo');
      });
    </script>
    <script>
      // Proteção das fotos (14/11/2026): sem menu "salvar imagem" (clique direito ou toque longo) e sem
      // arrastar a foto para fora da página. Um aviso curto explica o motivo. Não impede uma captura de
      // tela; a proteção legal está em /direitos-autorais.
      const aviso = document.querySelector<HTMLElement>('[data-aviso-protecao]');
      let tempo: ReturnType<typeof setTimeout> | undefined;
      const naFoto = (alvo: EventTarget | null) => alvo instanceof Element && alvo.closest('picture, img') !== null;
      document.addEventListener('contextmenu', (e) => {
        if (!naFoto(e.target)) return;
        e.preventDefault();
        if (!aviso) return;
        aviso.textContent = 'As fotos são protegidas por direitos autorais.';
        aviso.classList.add('visivel');
        clearTimeout(tempo);
        tempo = setTimeout(() => aviso.classList.remove('visivel'), 2600);
      });
      document.addEventListener('dragstart', (e) => {
        if (naFoto(e.target)) e.preventDefault();
      });
    </script>
  </body>
</html>
