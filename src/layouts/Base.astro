---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Abertura from '../components/Abertura.astro';
import { PREVIA } from '../lib/fotos';
import { site } from '../data/site';

interface Props {
  titulo: string;
  descricao: string;
  tema?: 'claro' | 'escuro';
  /** Caminho da imagem 1200x630 (Open Graph), quando a foto está autorizada. */
  imagem?: string;
  jsonld?: Record<string, unknown>;
  /** Página com a capa de couro na abertura (só a home). */
  abertura?: boolean;
}

const { titulo, descricao, tema = 'escuro', imagem, jsonld, abertura = false } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemAbs = imagem ? new URL(imagem, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR" data-type="service">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    {
      abertura && (
        <script is:inline>
          try {
            if (sessionStorage.getItem('capa-vista')) document.documentElement.classList.add('ja-abriu');
            else sessionStorage.setItem('capa-vista', '1');
          } catch (e) {}
        </script>
      )
    }
    <link rel="canonical" href={canonica} />
    {PREVIA && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={tema === 'claro' ? '#EFE6D6' : '#121B18'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    {imagemAbs && <meta property="og:image" content={imagemAbs} />}
    {imagemAbs && <meta property="og:image:width" content="1200" />}
    {imagemAbs && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imagemAbs ? 'summary_large_image' : 'summary'} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body class:list={{ 'tema-claro': tema === 'claro' }}>
    {abertura && <Abertura />}
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <slot name="depois" />
    <Rodape />
  </body>
</html>
