---
// Escolha das fotos pelo fotógrafo: estrela = entra no álbum, casinha = capa da amostra.
// Só existe no `npm run dev`; em produção getStaticPaths não gera nenhuma rota.
// Os dados vêm do plugin scripts/curadoria-dev.mjs (rotas /__curadoria/...).
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { x: undefined } }] : [];
}
---

<Base titulo="Escolha das fotos | Jr_Tech_OFC (só no seu computador)" descricao="Marque as fotos de cada amostra.">
  <div class="cur wrap" data-cur>
    <header class="cur-topo">
      <p class="sobretitulo">Só no seu computador</p>
      <h1 class="h2">Escolha das <em>fotos</em></h1>
      <ul class="cur-ajuda">
        <li><span class="ic ic-on" aria-hidden="true">★</span> <strong>Estrela:</strong> a foto entra no álbum da amostra.</li>
        <li><span class="ic ic-on" aria-hidden="true">⌂</span> <strong>Casinha:</strong> a capa da amostra. Uma por amostra.</li>
        <li>Cada amostra aparece no site com 1 capa e pelo menos <span data-minimo>4</span> estrelas.</li>
        <li>Clique na foto para ver grande. No modo grande: <kbd>E</kbd> estrela, <kbd>C</kbd> casinha, <kbd>←</kbd> <kbd>→</kbd> trocar de foto.</li>
      </ul>
    </header>

    <nav class="cur-amostras" aria-label="Amostras" data-amostras></nav>

    <div class="cur-barra couro" data-barra>
      <div class="cur-filtro" role="group" aria-label="Mostrar">
        <button type="button" aria-pressed="true" data-filtro="todas">Todas</button>
        <button type="button" aria-pressed="false" data-filtro="estrela">Só com estrela</button>
      </div>
      <p class="cur-resumo" data-resumo aria-live="polite"></p>
      <div class="cur-aplicar">
        <button type="button" class="botao" data-aplicar>Aplicar no site</button>
        <p class="legenda" data-status aria-live="polite"></p>
      </div>
    </div>

    <ul class="cur-grade" data-grade></ul>
    <p class="texto" data-erro hidden></p>
  </div>

  <dialog class="cur-ver" data-ver aria-label="Foto em tamanho grande">
    <img alt="" data-ver-img />
    <div class="cur-ver-barra">
      <button type="button" class="cur-ver-nav" data-ver-ant>← Anterior</button>
      <span class="legenda" data-ver-nome></span>
      <span class="cur-ver-marcas">
        <button type="button" class="marca-btn" data-ver-estrela aria-pressed="false">★ Estrela</button>
        <button type="button" class="marca-btn" data-ver-casa aria-pressed="false">⌂ Casinha</button>
      </span>
      <button type="button" class="cur-ver-nav" data-ver-prox>Próxima →</button>
      <button type="button" class="cur-ver-nav" data-ver-fechar>Fechar</button>
    </div>
  </dialog>
</Base>

<script>
  type Foto = { arquivo: string; mini: string; w?: number; h?: number };
  type Amostra = { sigla: string; nome: string; slug?: string; fotos: Foto[] };
  type Sel = { estrelas: string[]; casa: string | null };
  type Estado = { amostras: Amostra[]; selecao: Record<string, Sel>; minimo: number };

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const grade = $('[data-grade]');
  const navAmostras = $('[data-amostras]');
  const resumo = $('[data-resumo]');
  const statusEl = $('[data-status]');
  const btnAplicar = $<HTMLButtonElement>('[data-aplicar]');
  const ver = $<HTMLDialogElement>('[data-ver]');
  const verImg = $<HTMLImageElement>('[data-ver-img]');

  let estado: Estado;
  let atual = '';
  let filtro: 'todas' | 'estrela' = 'todas';
  let aberta = -1;

  const sel = (sigla = atual): Sel => estado.selecao[sigla] ?? { estrelas: [], casa: null };
  const amostra = () => estado.amostras.find((a) => a.sigla === atual)!;
  const visiveis = () => amostra().fotos.filter((f) => filtro === 'todas' || sel().estrelas.includes(f.arquivo));
  const miniUrl = (f: Foto) => `/__curadoria/mini/${atual}/${encodeURIComponent(f.mini)}`;

  function desenharAmostras() {
    navAmostras.replaceChildren(
      ...estado.amostras.map((a) => {
        const s = sel(a.sigla);
        const ok = s.casa && s.estrelas.length >= estado.minimo;
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'amostra-btn';
        b.setAttribute('aria-pressed', String(a.sigla === atual));
        b.innerHTML = `<span class="amostra-nome"></span><span class="amostra-conta">${s.estrelas.length} ★ ${s.casa ? '· ⌂' : ''}</span><span class="amostra-ok ${ok ? 'sim' : ''}">${ok ? 'no site' : 'fora do site'}</span>`;
        b.querySelector('.amostra-nome')!.textContent = a.nome;
        b.addEventListener('click', () => {
          atual = a.sigla;
          try { localStorage.setItem('cur-amostra', atual); } catch {}
          desenharTudo();
        });
        return b;
      }),
    );
  }

  function cartao(f: Foto) {
    const s = sel();
    const estrela = s.estrelas.includes(f.arquivo);
    const casa = s.casa === f.arquivo;
    const li = document.createElement('li');
    li.className = 'cartao' + (estrela ? ' com-estrela' : '') + (casa ? ' e-capa' : '');
    li.dataset.arquivo = f.arquivo;
    li.innerHTML = `
      <button type="button" class="cartao-foto" aria-label="Ver grande: ${f.arquivo}">
        <img loading="lazy" decoding="async" alt="" ${f.w ? `width="${f.w}" height="${f.h}"` : ''}>
        ${casa ? '<span class="selo">Capa</span>' : ''}
      </button>
      <div class="cartao-acoes">
        <button type="button" class="marca-btn" data-tipo="estrela" aria-pressed="${estrela}" aria-label="Estrela: ${f.arquivo}" title="Estrela (entra no álbum)">★</button>
        <button type="button" class="marca-btn" data-tipo="casa" aria-pressed="${casa}" aria-label="Casinha (capa): ${f.arquivo}" title="Casinha (capa da amostra)">⌂</button>
        <span class="cartao-nome"></span>
      </div>`;
    li.querySelector('img')!.src = miniUrl(f);
    li.querySelector('.cartao-nome')!.textContent = f.arquivo;
    return li;
  }

  function desenharGrade() {
    const lista = visiveis();
    grade.replaceChildren(...lista.map(cartao));
    const s = sel();
    const falta = [];
    if (!s.casa) falta.push('escolha a capa (casinha)');
    if (s.estrelas.length < estado.minimo) falta.push(`faltam ${estado.minimo - s.estrelas.length} estrelas`);
    resumo.textContent = `${amostra().nome}: ${s.estrelas.length} com estrela de ${amostra().fotos.length}. ` + (falta.length ? `Para aparecer no site: ${falta.join(' e ')}.` : 'Pronta para o site.');
  }

  function desenharTudo() {
    desenharAmostras();
    desenharGrade();
  }

  async function marcar(arquivo: string, tipo: 'estrela' | 'casa') {
    const s = sel();
    const valor = tipo === 'casa' ? s.casa !== arquivo : !s.estrelas.includes(arquivo);
    // Mostra na hora; o servidor confirma em seguida.
    const novo: Sel = { estrelas: [...s.estrelas], casa: s.casa };
    if (tipo === 'casa') {
      novo.casa = valor ? arquivo : null;
      if (valor && !novo.estrelas.includes(arquivo)) novo.estrelas.push(arquivo);
    } else if (valor) novo.estrelas.push(arquivo);
    else {
      novo.estrelas = novo.estrelas.filter((a) => a !== arquivo);
      if (novo.casa === arquivo) novo.casa = null;
    }
    estado.selecao[atual] = novo;
    desenharTudo();
    if (aberta >= 0) atualizarVer();
    try {
      const r = await fetch('/__curadoria/marcar', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ sigla: atual, arquivo, tipo, valor }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.erro);
      estado.selecao[d.sigla] = d.selecao;
      statusEl.textContent = 'Seleção salva. Clique em "Aplicar no site" para ver no portfólio.';
    } catch (e) {
      statusEl.textContent = `Não salvou: ${(e as Error).message}. Recarregue a página.`;
    }
  }

  grade.addEventListener('click', (ev) => {
    const alvo = ev.target as HTMLElement;
    const li = alvo.closest<HTMLElement>('.cartao');
    if (!li) return;
    const btn = alvo.closest<HTMLButtonElement>('.marca-btn');
    if (btn) return marcar(li.dataset.arquivo!, btn.dataset.tipo as 'estrela' | 'casa');
    if (alvo.closest('.cartao-foto')) abrir(visiveis().findIndex((f) => f.arquivo === li.dataset.arquivo));
  });

  document.querySelectorAll<HTMLButtonElement>('[data-filtro]').forEach((b) =>
    b.addEventListener('click', () => {
      filtro = b.dataset.filtro as typeof filtro;
      document.querySelectorAll('[data-filtro]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      desenharGrade();
    }),
  );

  // Ver grande
  function atualizarVer() {
    const f = visiveis()[aberta];
    if (!f) return ver.close();
    verImg.src = miniUrl(f);
    const grande = new Image();
    grande.src = `/__curadoria/grande/${atual}/${encodeURIComponent(f.arquivo)}`;
    grande.onload = () => visiveis()[aberta] === f && (verImg.src = grande.src);
    verImg.alt = f.arquivo;
    $('[data-ver-nome]').textContent = `${aberta + 1} / ${visiveis().length} · ${f.arquivo}`;
    $('[data-ver-estrela]').setAttribute('aria-pressed', String(sel().estrelas.includes(f.arquivo)));
    $('[data-ver-casa]').setAttribute('aria-pressed', String(sel().casa === f.arquivo));
  }
  function abrir(i: number) {
    aberta = i;
    atualizarVer();
    if (!ver.open) ver.showModal();
  }
  const mover = (d: number) => {
    const n = visiveis().length;
    if (n) abrir((aberta + d + n) % n);
  };
  $('[data-ver-ant]').addEventListener('click', () => mover(-1));
  $('[data-ver-prox]').addEventListener('click', () => mover(1));
  $('[data-ver-fechar]').addEventListener('click', () => ver.close());
  $('[data-ver-estrela]').addEventListener('click', () => marcar(visiveis()[aberta].arquivo, 'estrela'));
  $('[data-ver-casa]').addEventListener('click', () => marcar(visiveis()[aberta].arquivo, 'casa'));
  ver.addEventListener('close', () => {
    const arq = visiveis()[aberta]?.arquivo;
    aberta = -1;
    grade.querySelector<HTMLElement>(`.cartao[data-arquivo="${CSS.escape(arq ?? '')}"] .cartao-foto`)?.focus();
  });
  ver.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowRight') mover(1);
    else if (ev.key === 'ArrowLeft') mover(-1);
    else if (ev.key.toLowerCase() === 'e') marcar(visiveis()[aberta].arquivo, 'estrela');
    else if (ev.key.toLowerCase() === 'c') marcar(visiveis()[aberta].arquivo, 'casa');
  });

  // Aplicar no site
  async function acompanhar() {
    const r = await fetch('/__curadoria/status');
    const { status } = await r.json();
    statusEl.textContent = status.etapa + (status.fim && status.fim !== 'ok' ? `: ${status.fim}` : '');
    if (status.rodando) return setTimeout(acompanhar, 1500);
    btnAplicar.disabled = false;
    if (status.fim === 'ok') statusEl.textContent = 'Pronto. Abra o portfólio para ver (pode precisar recarregar a página).';
  }
  btnAplicar.addEventListener('click', async () => {
    btnAplicar.disabled = true;
    statusEl.textContent = 'Começando…';
    await fetch('/__curadoria/aplicar', { method: 'POST' });
    acompanhar();
  });

  (async () => {
    const r = await fetch('/__curadoria/estado');
    const d = await r.json();
    if (!r.ok) {
      const erro = $('[data-erro]');
      erro.hidden = false;
      erro.textContent = d.erro;
      return;
    }
    estado = d;
    $('[data-minimo]').textContent = String(d.minimo);
    let salvo = '';
    try { salvo = localStorage.getItem('cur-amostra') ?? ''; } catch {}
    atual = estado.amostras.some((a) => a.sigla === salvo) ? salvo : estado.amostras[0].sigla;
    desenharTudo();
    if (d.status?.rodando) acompanhar();
  })();
</script>

<style>
  .cur {
    padding-block: var(--s5) var(--secao);
    display: grid;
    gap: var(--s4);
  }
  .cur-topo {
    display: grid;
    gap: var(--s2);
  }
  .cur-ajuda {
    display: grid;
    gap: 6px;
    padding: 0;
    list-style: none;
    color: var(--texto-2);
  }
  .cur-ajuda strong {
    color: var(--texto);
  }
  .ic {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--verde);
    color: #0d1512;
    font-weight: 700;
  }
  kbd {
    padding: 1px 7px;
    border: 1px solid var(--divisao);
    border-radius: 6px;
    font: inherit;
    font-size: 0.9em;
  }
  .cur-amostras {
    display: flex;
    gap: var(--s1);
    overflow-x: auto;
    padding-bottom: var(--s1);
  }
  .cur-amostras :global(.amostra-btn) {
    flex: none;
    display: grid;
    gap: 2px;
    justify-items: start;
    min-height: 44px;
    padding: 10px 18px;
    border: 1.5px dashed var(--costura-suave);
    border-radius: 18px;
    background: transparent;
    color: var(--texto);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .cur-amostras :global(.amostra-btn[aria-pressed='true']) {
    background: var(--painel);
    border-style: solid;
    border-color: var(--costura);
  }
  .cur-amostras :global(.amostra-nome) {
    font-weight: 650;
    white-space: nowrap;
  }
  .cur-amostras :global(.amostra-conta),
  .cur-amostras :global(.amostra-ok) {
    font-size: 13px;
    color: var(--texto-2);
  }
  .cur-amostras :global(.amostra-ok.sim) {
    color: var(--verde);
  }
  .cur-barra {
    position: sticky;
    top: calc(var(--cab) + 8px);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2) var(--s3);
    padding: 16px 24px;
  }
  .cur-filtro {
    display: flex;
    gap: var(--s1);
  }
  .cur-filtro button {
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px dashed var(--costura-suave);
    border-radius: 999px;
    background: transparent;
    color: var(--texto-2);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .cur-filtro button[aria-pressed='true'] {
    color: var(--texto);
    border-style: solid;
    border-color: var(--costura);
  }
  .cur-resumo {
    flex: 1 1 260px;
    font-weight: 550;
  }
  .cur-aplicar {
    display: grid;
    gap: 4px;
    justify-items: end;
  }
  .cur-aplicar .legenda {
    max-width: 36ch;
    text-align: right;
  }
  .cur-grade {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--s2);
  }
  .cur-grade :global(.cartao) {
    display: grid;
    gap: 8px;
    padding: 8px;
    border-radius: 18px;
    border: 2px solid transparent;
    background: rgb(0 0 0 / 0.18);
  }
  .cur-grade :global(.cartao.com-estrela) {
    border: 2px dashed var(--costura);
    background: var(--painel);
  }
  .cur-grade :global(.cartao.e-capa) {
    border-style: solid;
    border-color: var(--verde);
  }
  .cur-grade :global(.cartao-foto) {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #0b110f;
    cursor: zoom-in;
  }
  .cur-grade :global(.cartao-foto img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cur-grade :global(.selo) {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--verde);
    color: #0d1512;
    font-size: 12px;
    font-weight: 700;
  }
  .cur-grade :global(.cartao-acoes) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .cur-grade :global(.cartao-nome) {
    font-size: 12px;
    color: var(--texto-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.marca-btn) {
    flex: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border: 1.5px solid var(--divisao);
    border-radius: 999px;
    background: transparent;
    color: var(--texto-2);
    font: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    transition: background-color var(--t-estado), color var(--t-estado);
  }
  :global(.marca-btn:hover) {
    color: var(--texto);
    border-color: var(--costura);
  }
  :global(.marca-btn[aria-pressed='true']) {
    background: var(--verde);
    border-color: var(--verde);
    color: #0d1512;
  }
  .cur-ver {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(11 17 15 / 0.97);
    color: #f2eee6;
  }
  .cur-ver[open] {
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .cur-ver img {
    place-self: center;
    max-width: 100%;
    max-height: calc(100dvh - 90px);
    object-fit: contain;
    border-radius: 12px;
  }
  .cur-ver-barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    padding: var(--s2);
  }
  .cur-ver-marcas {
    display: flex;
    gap: var(--s1);
  }
  .cur-ver .marca-btn {
    font-size: 16px;
    font-weight: 650;
    color: #f2eee6;
  }
  .cur-ver-nav {
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px dashed rgb(0 252 168 / 0.5);
    border-radius: 999px;
    background: transparent;
    color: #f2eee6;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
