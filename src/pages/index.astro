---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Heroi, { type Quadro } from '../components/Heroi.astro';
import Capitulos from '../components/Capitulos.astro';
import Historias, { type Historia } from '../components/Historias.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import Icone from '../components/Icone.astro';
import Capa from '../components/Capa.astro';
import SecaoServicos from '../components/SecaoServicos.astro';
import SecaoSobre from '../components/SecaoSobre.astro';
import { capaDe, capasDe, emDestaque, ensaiosPublicaveis, fotoDe, fotosDoEnsaio, maisRecente, type Ensaio, type FotoEnsaio } from '../lib/fotos';
import { CAPA_SOCIAL, CHAMADA, linkInstagram, linkWhatsApp, site, tipoDoEnsaio } from '../data/site';

// Home pensada para o celular: abertura com a foto no alto e o botão de orçamento, destaques no
// estilo dos Stories, álbuns em capítulos por tipo de trabalho, uma foto de pausa, a página de
// papel creme com o resumo de Serviços e Sobre (cada um com a página completa, desde 14/11/2026),
// a chamada final e o rodapé. O assistente abre pelo botão flutuante (layouts/Base.astro).
// As fotos vêm dos manifestos em src/content/ensaios; a ordem dos álbuns, de DESTAQUES (site.ts).
const ensaios = await ensaiosPublicaveis();

// Tipo do trabalho, cidade (quando há) e ano: "Ensaio externo · Bacabal · 2025".
const ficha = (e: Ensaio) => [e.data.rotulo, e.data.cidade, e.data.data.slice(0, 4)].filter(Boolean).join(' · ');

// Abertura: as fotos de abertura dos quatro primeiros álbuns em destaque se alternam, a começar
// pela Sabrina (a foto do livro), com o ponto focal do manifesto.
const rolo: Quadro[] = ensaios.slice(0, 4).flatMap((e) => {
  const foto = fotosDoEnsaio(e).find((f) => f.arquivo === e.data.abertura.arquivo) || capaDe(e);
  if (!foto) return [];
  return [{ foto, foco: e.data.abertura.foco, nome: e.data.nome, legenda: ficha(e), href: `/trabalhos/${e.id}` }];
});
// Título da abertura: três frases, uma por linha, palavra por palavra (cada uma sobe por trás de
// uma máscara).
const titulo: [string, boolean?][][] = [
  [['Seu'], ['ensaio.']],
  [['Seu'], ['evento.']],
  [['Seu'], ['álbum.', true]],
];

// Cada álbum vira uma história: a capa (ou as duas, quando se alternam) e as primeiras fotos.
const totalFotos = ensaios.reduce((n, e) => n + fotosDoEnsaio(e).length, 0);
const tipos = ensaios.map((e) => tipoDoEnsaio(e.data.categoria, e.data.rotulo));
const historias: Historia[] = ensaios.map((e) => {
  const capas = capasDe(e);
  const resto = fotosDoEnsaio(e).filter((f) => !capas.includes(f));
  return {
    nome: e.data.nome,
    legenda: ficha(e),
    href: `/trabalhos/${e.id}`,
    fotos: [...capas, ...resto.slice(0, 8 - capas.length)],
  };
});
// Fileira "Em destaque": só os álbuns escolhidos pelo fotógrafo, na ordem dele. `i` é a posição
// do álbum na lista de Stories.
const escolhidos = ensaios.map((e, i) => ({ e, i })).filter(({ e }) => emDestaque(e));
const destaques = escolhidos.length ? escolhidos : ensaios.map((e, i) => ({ e, i }));
const novo = maisRecente(ensaios);

// Foto de pausa: a primeira horizontal da lista sugerida no docs/DESIGN.md §12 que estiver na seleção.
const candidatasPausa: [string, string][] = [
  ['sara-e-yasmin', 'IMG_0957.jpg'],
  ['bodas-de-ouro-nelson-e-dalvina', 'Wedding Anniversary (35).jpg'],
];
let pausa: FotoEnsaio | null = null;
for (const [s, a] of candidatasPausa) {
  pausa = await fotoDe(s, a);
  if (pausa) break;
}
if (!pausa) {
  pausa = ensaios.flatMap((e) => fotosDoEnsaio(e)).find((f) => f.dados.width > f.dados.height * 1.2) ?? null;
}

const descricao =
  'Ensaios externos, casais, gestantes, aniversários, festas de 15 anos e cobertura de eventos em Bacabal e Imperatriz. Conheça os álbuns da Jr_Tech_OFC e solicite um orçamento.';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.nome,
  description: descricao,
  url: Astro.site?.href,
  founder: { '@type': 'Person', name: site.fotografo },
  areaServed: [
    { '@type': 'City', name: 'Bacabal' },
    { '@type': 'City', name: 'Imperatriz' },
  ],
  telephone: `+${site.whatsapp}`,
  email: site.email,
  sameAs: [linkInstagram],
  ...(rolo[0]?.foto.dados.og ? { image: new URL(rolo[0].foto.dados.og, Astro.site).href } : {}),
};
---

<Base
  titulo="Jr_Tech_OFC Fotografia | Ensaios e eventos em Bacabal e Imperatriz"
  descricao={descricao}
  imagem={CAPA_SOCIAL.imagem}
  social={CAPA_SOCIAL}
  jsonld={jsonld}
  abertura
>
  <Heroi foto={rolo[0]?.foto ?? null} foco={rolo[0]?.foco} rolo={rolo}>
    <p class="sobretitulo entra" style="--i:0">Fotografia · Bacabal e Imperatriz</p>
    <h1 class="heroi-titulo serifa palavras">
      {
        titulo.map((linha, l) => (
          <span class="heroi-linha">
            {linha.map(([palavra, italico], p) => (
              <Fragment>
                <span class="p">
                  <span style={`--j:${l * 2 + p}`}>{italico ? <em>{palavra}</em> : palavra}</span>
                </span>{' '}
              </Fragment>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="heroi-apoio entra" style="--i:5">
      Ensaios individuais e de casal, gestantes, aniversários, festas de 15 anos e cobertura de eventos. Fotografias
      com direção leve, atenção aos detalhes e espaço para os momentos espontâneos.
    </p>
    <div class="acoes entra" style="--i:6">
      <a class="botao" href={linkWhatsApp()} data-wa-auto>
        <Icone nome="whatsapp" tamanho={20} />
        {CHAMADA}
      </a>
      <a class="botao-fantasma" href="/trabalhos">
        <Icone nome="grade" tamanho={18} />
        Explorar portfólio
      </a>
    </div>
  </Heroi>

  {
    historias.length > 0 && (
      <section class="destaques" aria-labelledby="destaques-titulo">
        <div class="wrap destaques-topo">
          <h2 class="destaques-titulo serifa" id="destaques-titulo">
            Em <em>destaque</em>
          </h2>
          <p class="destaques-apoio">Uma seleção de ensaios e celebrações registrados pela {site.marca}.</p>
        </div>
        <ul class="trilho destaques-lista" data-reordenar>
          {destaques.map(({ e, i }, n) => (
            <li class="surge-lado" data-tipo={tipos[i]}>
              <button type="button" class="destaque" data-historia={i}>
                <span class="destaque-anel">
                  <Capa ensaio={e} sizes="96px" prioridade={n < 4} />
                  {e.id === novo?.id && <span class="destaque-novo">Novo</span>}
                </span>
                <span class="destaque-nome">{e.data.nome}</span>
                <span class="destaque-ficha">
                  <span>{e.data.rotulo}</span>
                  <span>{[e.data.cidade, e.data.data.slice(0, 4)].filter(Boolean).join(' · ')}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="secao trabalhos" id="trabalhos" aria-labelledby="trabalhos-titulo">
    <div class="wrap secao-topo surge">
      <p class="sobretitulo">Portfólio</p>
      <h2 class="h2" id="trabalhos-titulo">O portfólio em <em>capítulos</em></h2>
      <p class="lead">
        {ensaios.length} álbuns e {totalFotos} fotografias, organizados por tipo de trabalho. Explore os ensaios, as celebrações
        e os momentos registrados.
      </p>
    </div>
    <Capitulos ensaios={ensaios} />
    <p class="wrap todos surge">
      <a class="botao-fantasma" href="/trabalhos">
        <Icone nome="grade" tamanho={20} />
        Ver todos os álbuns
      </a>
    </p>
  </section>

  {
    pausa && (
      <figure class="pausa">
        <div class="pausa-foto revela">
          <Foto slug={pausa.slug} arquivo={pausa.arquivo} alt={pausa.alt} sizes="100vw" />
        </div>
      </figure>
    )
  }

  <div class="papel tema-claro">
    <SecaoServicos resumo />
    <SecaoSobre resumo />
  </div>

  <ChamadaFinal auto />

  <Historias historias={historias} slot="depois" />
</Base>

<style>
  .heroi-titulo {
    font-size: clamp(44px, 11.6vw, 104px);
    font-weight: 380;
    line-height: 0.95;
    letter-spacing: -0.034em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .heroi-linha {
    display: block;
  }
  .heroi-apoio {
    max-width: 44ch;
    font-size: clamp(15.5px, 4.1vw, 19px);
    line-height: 1.46;
    color: #e6e1d7;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: var(--s1);
  }
  /* Os dois botões cabem lado a lado na maioria dos celulares */
  .acoes .botao {
    padding-inline: 18px 20px;
    gap: 8px;
    font-size: 16px;
  }
  .acoes .botao-fantasma {
    padding-inline: 14px 16px;
    gap: 8px;
    font-size: 16px;
  }

  /* Destaques: círculos com costura verde, como os destaques do Instagram */
  .destaques {
    padding-top: var(--s5);
  }
  .destaques-topo {
    display: grid;
    gap: 6px;
    margin-bottom: var(--s3);
  }
  .destaques-titulo {
    font-size: clamp(28px, 7vw, 40px);
    font-weight: 380;
    line-height: 1.05;
  }
  .destaques-apoio {
    max-width: 44ch;
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--texto-2);
  }
  .destaques-lista {
    list-style: none;
    margin: 0;
    gap: 12px;
    padding-block: 6px var(--s1);
  }
  .destaque {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 8px;
    width: 104px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--texto);
    font: inherit;
    cursor: pointer;
  }
  .destaque-anel {
    position: relative;
    display: block;
    width: 84px;
    height: 84px;
    padding: 4px;
    border: 2px dashed var(--verde);
    border-radius: 999px;
    transition: transform 200ms var(--curva);
  }
  .destaque:active .destaque-anel {
    transform: scale(0.92);
  }
  .destaque:hover .destaque-anel {
    border-style: solid;
  }
  .destaque-anel :global(.foto) {
    width: 100%;
    height: 100%;
    border-radius: 999px;
  }
  /* O álbum mais recente */
  .destaque-novo {
    position: absolute;
    top: -6px;
    right: -8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--folha);
    color: #06241b;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 4px 10px -4px rgb(0 0 0 / 0.7);
  }
  .destaque-nome {
    width: 100%;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  /* Tipo do trabalho, cidade e ano, em duas linhas curtas */
  .destaque-ficha {
    display: grid;
    width: 100%;
    margin-top: -4px;
    font-size: 11.5px;
    line-height: 1.35;
    color: var(--texto-2);
    text-align: center;
  }
  .destaque-ficha > span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .destaque:focus-visible {
    outline: none;
  }
  .destaque:focus-visible .destaque-anel {
    outline: 2px solid var(--foco);
    outline-offset: 3px;
  }

  .secao-topo {
    justify-items: start;
  }
  .todos {
    margin-top: var(--s4);
  }

  /* Pausa: uma foto horizontal de ponta a ponta, que se abre ao entrar na tela */
  .pausa {
    margin: 0;
    overflow: hidden;
  }
  .pausa-foto :global(.foto) {
    border-radius: 0;
  }

  /* Páginas de papel: respiro entre a foto de pausa e a chamada final */
  .papel {
    margin-block: var(--s4) var(--s5);
  }
</style>
