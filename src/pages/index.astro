---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Heroi from '../components/Heroi.astro';
import Capitulos from '../components/Capitulos.astro';
import Historias, { type Historia } from '../components/Historias.astro';
import BarraWhatsApp from '../components/BarraWhatsApp.astro';
import Assistente from '../components/Assistente.astro';
import { capaDe, ensaiosPublicaveis, fotoDe, fotosDoEnsaio, type FotoEnsaio } from '../lib/fotos';
import { linkEmail, linkInstagram, linkWhatsApp, site, tipoDoEnsaio } from '../data/site';

// Home pensada para o celular (revisão de 13/11/2026): abertura em tela cheia, destaques no estilo
// dos Stories, assistente, álbuns em capítulos por tipo de trabalho, uma foto de pausa, as páginas
// de papel creme (como funciona e sobre) e o contato.
// Tudo vem da seleção feita na página /curadoria.
const ensaios = await ensaiosPublicaveis();
const abertura = (await fotoDe('sara-e-yasmin', 'IMG_1081.jpg')) ?? (ensaios[0] ? capaDe(ensaios[0]) : null);
const focoAbertura = abertura?.slug === 'sara-e-yasmin' ? '50% 22%' : '50% 30%';

// Cada álbum vira uma história: a capa e as primeiras fotos escolhidas.
const totalFotos = ensaios.reduce((n, e) => n + fotosDoEnsaio(e).length, 0);
const tipos = ensaios.map((e) => tipoDoEnsaio(e.data.categoria, e.data.rotulo));
const historias: Historia[] = ensaios.map((e) => {
  const fotos = fotosDoEnsaio(e);
  const capa = fotos.find((f) => f.arquivo === e.data.capa);
  const resto = fotos.filter((f) => f !== capa);
  return {
    nome: e.data.nome,
    legenda: [e.data.rotulo, e.data.data.slice(0, 4)].join(' · '),
    href: `/trabalhos/${e.id}`,
    fotos: [...(capa ? [capa] : []), ...resto.slice(0, 7)],
  };
});

// Foto de pausa: a primeira horizontal da lista sugerida no DESIGN.md §12 que estiver na seleção.
const candidatasPausa: [string, string][] = [
  ['sara-e-yasmin', 'IMG_0957.jpg'],
  ['dalila-e-maria', 'Dalila e Maria (3).jpg'],
  ['bodas-de-ouro-nelson-e-dalvina', 'Wedding Anniversary (35).jpg'],
];
let pausa: FotoEnsaio | null = null;
for (const [s, a] of candidatasPausa) {
  pausa = await fotoDe(s, a);
  if (pausa) break;
}
if (!pausa) {
  pausa = ensaios.flatMap((e) => fotosDoEnsaio(e)).find((f) => f.dados.width > f.dados.height * 1.2) ?? null;
}
const sobreFoto = (await fotoDe('marlieth-e-paulo', 'Foto (6).jpg')) ?? (await fotoDe('marlieth-e-paulo', 'Foto (9).jpg'));

const passos = [
  ['Conversa', 'Pelo WhatsApp você me conta a ideia, a data e a cidade.'],
  ['Planejamento', 'Definimos juntos o lugar, o horário de luz mais bonito, as roupas e o que será entregue.'],
  ['Ensaio', 'Eu conduzo as poses com calma e deixo espaço para o que acontece de verdade.'],
  ['Seleção e edição', 'Escolho as melhores fotos e trato cada uma com cuidado.'],
  ['Entrega', 'Suas fotos editadas chegam no formato combinado.'],
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.nome,
  description: 'Fotografia de ensaios externos, casais, gestantes e eventos.',
  url: Astro.site?.href,
  founder: { '@type': 'Person', name: site.fotografo },
  areaServed: [
    { '@type': 'City', name: 'Imperatriz' },
    { '@type': 'City', name: 'Bacabal' },
  ],
  telephone: `+${site.whatsapp}`,
  email: site.email,
  sameAs: [linkInstagram],
  ...(abertura?.dados.og ? { image: new URL(abertura.dados.og, Astro.site).href } : {}),
};
---

<Base
  titulo="Portfólio de José Renato | Jr_Tech_OFC Fotografia, Imperatriz e Bacabal"
  descricao="Veja o portfólio de José Renato: ensaios externos, casais, gestantes, 15 anos e eventos em Imperatriz e Bacabal, MA. Chame no WhatsApp."
  imagem={abertura?.dados.og}
  jsonld={jsonld}
  abertura
>
  <Heroi foto={abertura} foco={focoAbertura}>
    <p class="sobretitulo entra" style="--i:0">{site.marca} Fotografia</p>
    <h1 class="heroi-titulo serifa entra" style="--i:1">Fotos que <em>parecem</em> com você.</h1>
    <p class="heroi-apoio entra" style="--i:2">Ensaios, casais, gestantes, 15 anos e celebrações em {site.cidades}.</p>
    <div class="acoes entra" style="--i:3">
      <button type="button" class="botao" data-historia="0">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
        Ver as fotos
      </button>
      <a class="botao-sec" href="#assistente">Me ajude a escolher</a>
    </div>
  </Heroi>

  {
    historias.length > 0 && (
      <section class="destaques" aria-labelledby="destaques-titulo">
        <h2 class="wrap sobretitulo destaques-titulo" id="destaques-titulo">Em destaque</h2>
        <ul class="trilho destaques-lista" data-reordenar>
          {historias.map((h, i) => (
            <li class="surge-lado" data-tipo={tipos[i]}>
              <button type="button" class="destaque" data-historia={i}>
                <span class="destaque-anel">
                  {h.fotos[0] && (
                    <Foto slug={h.fotos[0].slug} arquivo={h.fotos[0].arquivo} alt="" sizes="96px" recorte="50% 30%" prioridade={i < 4} />
                  )}
                </span>
                <span class="destaque-nome">{h.nome}</span>
              </button>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Assistente />

  <section class="secao trabalhos" id="trabalhos" aria-labelledby="trabalhos-titulo">
    <div class="wrap secao-topo surge">
      <p class="sobretitulo">Portfólio</p>
      <h2 class="h2" id="trabalhos-titulo">O portfólio em <em>capítulos</em></h2>
      <p class="texto apoio">{ensaios.length} álbuns e {totalFotos} fotos, organizados por tipo de trabalho.</p>
    </div>
    <Capitulos ensaios={ensaios} />
    <p class="wrap todos surge">
      <a class="botao-sec" href="/trabalhos">Ver todos os álbuns em uma página</a>
    </p>
  </section>

  {
    pausa && (
      <figure class="pausa">
        <div class="pausa-foto revela">
          <Foto slug={pausa.slug} arquivo={pausa.arquivo} alt={pausa.alt} sizes="100vw" />
        </div>
      </figure>
    )
  }

  <div class="papel tema-claro">
    <section class="secao como" id="como-funciona" aria-labelledby="como-titulo">
      <div class="wrap secao-topo surge">
        <p class="sobretitulo">Como funciona</p>
        <h2 class="h2" id="como-titulo">Do primeiro contato à <em>entrega</em></h2>
      </div>
      <ol class="wrap passos">
        {
          passos.map(([titulo, texto], i) => (
            <li class="passo surge">
              <span class="passo-num serifa" aria-hidden="true">{i + 1}</span>
              <div class="passo-texto">
                <h3 class="titulo">{titulo}</h3>
                <p>{texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="secao sobre" id="sobre" aria-labelledby="sobre-titulo">
      <div class="wrap sobre-grade">
        {
          sobreFoto && (
            <div class="sobre-foto revela">
              <Foto slug={sobreFoto.slug} arquivo={sobreFoto.arquivo} alt={sobreFoto.alt} sizes="(min-width: 900px) 40vw, 92vw" />
            </div>
          )
        }
        <div class="sobre-texto surge">
          <p class="sobretitulo">Sobre</p>
          <h2 class="h2" id="sobre-titulo">José <em>Renato</em></h2>
          <p class="texto">
            Sou José Renato Alves da Silva, fotógrafo da {site.marca}. Fotografo pessoas em Imperatriz e Bacabal, quase sempre
            ao ar livre, e também cubro cultos, confraternizações, aniversários e festas de família. Gosto de foto que parece com
            quem está nela: natural, sem pose dura.
          </p>
          <a class="botao-sec" href={linkInstagram}>Mais no Instagram @{site.instagram}</a>
        </div>
      </div>
    </section>
  </div>

  <section class="secao" id="contato" aria-labelledby="contato-titulo" data-contato-ensaio>
    <div class="wrap">
      <div class="contato couro surge">
        <p class="sobretitulo">Contato</p>
        <h2 class="h2" id="contato-titulo">Vamos criar o seu <em>álbum?</em></h2>
        <p class="texto contato-apoio">Conte o que você imagina, a data e a cidade. Eu respondo pelo WhatsApp.</p>
        <a class="botao botao-grande" href={linkWhatsApp()} data-wa-auto>Conversar no WhatsApp</a>
        <div class="contato-outros">
          <a class="botao-sec" href={linkEmail}>Mandar e-mail</a>
          <a class="botao-sec" href={linkInstagram}>Instagram</a>
        </div>
        <p class="legenda">Atendo em {site.cidades}. Outras cidades, sob consulta.</p>
      </div>
    </div>
  </section>

  <Historias historias={historias} slot="depois" />
  <BarraWhatsApp slot="depois" auto />
</Base>

<style>
  .heroi-titulo {
    font-size: clamp(46px, 13vw, 112px);
    line-height: 0.95;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .heroi-apoio {
    max-width: 34ch;
    font-size: clamp(17px, 4.4vw, 21px);
    color: #e6e1d7;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
    margin-top: var(--s1);
  }
  .apoio {
    color: var(--texto-2);
  }

  /* Destaques: círculos com costura verde, como os destaques do Instagram */
  .destaques {
    padding-top: var(--s5);
  }
  .destaques-titulo {
    margin-bottom: var(--s2);
  }
  .destaques-lista {
    list-style: none;
    margin: 0;
    gap: 14px;
    padding-bottom: var(--s1);
  }
  .destaque {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 88px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--texto);
    font: inherit;
    cursor: pointer;
  }
  .destaque-anel {
    display: block;
    width: 84px;
    height: 84px;
    padding: 4px;
    border: 2px dashed var(--verde);
    border-radius: 999px;
    transition: transform 200ms var(--curva);
  }
  .destaque:active .destaque-anel {
    transform: scale(0.92);
  }
  .destaque:hover .destaque-anel {
    border-style: solid;
  }
  .destaque-anel :global(.foto) {
    width: 100%;
    height: 100%;
    border-radius: 999px;
  }
  .destaque-nome {
    width: 100%;
    font-size: 13px;
    font-weight: 550;
    line-height: 1.2;
    text-align: center;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .destaque:focus-visible {
    outline: none;
  }
  .destaque:focus-visible .destaque-anel {
    outline: 2px solid var(--foco);
    outline-offset: 3px;
  }

  .secao-topo {
    justify-items: start;
  }

  /* Pausa: uma foto horizontal de ponta a ponta, que se abre ao entrar na tela */
  .pausa {
    margin: 0;
    overflow: hidden;
  }
  .pausa-foto :global(.foto) {
    border-radius: 0;
  }

  .todos {
    margin-top: var(--s4);
  }

  /* Páginas de papel: respiro entre a foto de pausa e o contato */
  .papel {
    margin-block: var(--s4) 0;
  }

  /* Como funciona: linha do tempo costurada (no computador, cinco colunas) */
  .passos {
    list-style: none;
    margin: 0;
    display: grid;
    gap: var(--s4);
  }
  .passo {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: var(--s2);
    align-items: start;
  }
  .passo-num {
    font-size: 48px;
    font-style: italic;
    font-weight: 380;
    line-height: 0.9;
    text-align: center;
    color: var(--destaque);
  }
  .passo:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 54px;
    bottom: calc(var(--s4) * -1 + 8px);
    border-left: 1.5px dashed var(--costura-suave);
  }
  .passo-texto {
    display: grid;
    gap: 6px;
    padding-top: 6px;
  }
  .passo p {
    color: var(--texto-2);
  }
  @media (min-width: 1000px) {
    .passos {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .passo {
      grid-template-columns: minmax(0, 1fr);
    }
    .passo::before {
      display: none;
    }
    .passo-num {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 56px;
      text-align: left;
    }
    .passo-num::after {
      content: '';
      flex: 1;
      border-top: 1.5px dashed var(--costura-suave);
    }
  }

  /* Sobre */
  .sobre-grade {
    display: grid;
    gap: var(--s4);
    align-items: center;
  }
  .sobre-grade > * {
    min-width: 0;
  }
  .sobre-texto {
    display: grid;
    gap: var(--s2);
    justify-items: start;
  }
  .sobre-foto :global(.foto) {
    border-radius: var(--raio-g);
    box-shadow: var(--sombra);
  }
  @media (min-width: 900px) {
    .sobre-grade {
      grid-template-columns: 5fr 7fr;
      gap: var(--s6);
    }
  }

  /* Contato */
  .contato {
    display: grid;
    gap: var(--s3);
    justify-items: center;
    text-align: center;
    padding: clamp(48px, 7vw, 112px) clamp(24px, 5vw, 72px);
  }
  .contato-apoio {
    font-size: clamp(18px, 2vw, 22px);
    color: var(--texto-2);
  }
  .contato-outros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s1) var(--s4);
  }
  .botao-grande {
    min-height: 56px;
    padding-inline: 36px;
    font-size: 18px;
  }
</style>
