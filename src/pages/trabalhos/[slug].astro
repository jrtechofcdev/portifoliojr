---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Heroi from '../../components/Heroi.astro';
import Galeria from '../../components/Galeria.astro';
import Historias from '../../components/Historias.astro';
import BarraWhatsApp from '../../components/BarraWhatsApp.astro';
import { capaDe, ensaiosPublicaveis, fotosDoEnsaio, mesAno, type Ensaio } from '../../lib/fotos';
import { CATEGORIAS, linkWhatsApp } from '../../data/site';

export async function getStaticPaths() {
  const ensaios = await ensaiosPublicaveis();
  return ensaios.map((e, i) => {
    const proximo = ensaios[(i + 1) % ensaios.length];
    return { params: { slug: e.id }, props: { ensaio: e, proximo: proximo.id !== e.id ? proximo : null } };
  });
}

interface Props {
  ensaio: Ensaio;
  proximo: Ensaio | null;
}
const { ensaio, proximo } = Astro.props;
const d = ensaio.data;
const fotos = fotosDoEnsaio(ensaio);
const abertura = fotos.find((f) => f.arquivo === d.abertura.arquivo)!;
const evento = d.categoria === 'eventos';
const ficha = [d.cidade, mesAno(d.data), `${fotos.length} fotos`].filter(Boolean).join(' · ');
const pergunta = evento ? 'Tem uma data especial chegando?' : 'Quer um ensaio assim?';
const mensagem = evento
  ? `Olá, José Renato! Vi o álbum "${d.nome}" no seu portfólio e quero conversar sobre um evento.`
  : `Olá, José Renato! Vi o álbum "${d.nome}" no seu portfólio e quero um ensaio assim. Pode me contar como funciona?`;
const lugar = d.cidade ? ` em ${d.cidade}` : '';
const titulo = `${d.nome}, ${d.rotulo.toLowerCase()}${lugar} | Jr_Tech_OFC Fotografia`;
const descricao = `${d.rotulo} de ${d.nome}${lugar}, ${mesAno(d.data)}. ${fotos.length} fotos de José Renato, Jr_Tech_OFC Fotografia.`;
const capaProx = proximo ? capaDe(proximo) : null;
---

<Base titulo={titulo} descricao={descricao} tema={d.tema} imagem={abertura.dados.og}>
  <article>
    <Heroi foto={abertura} foco={d.abertura.foco} transicao={`capa-${ensaio.id}`}>
      <a class="sobretitulo entra" style="--i:0" href={`/trabalhos?c=${d.categoria}`}>{CATEGORIAS[d.categoria].titulo}</a>
      <h1 class="ensaio-titulo serifa entra" style="--i:1">{d.nome}</h1>
      <p class="ensaio-ficha entra" style="--i:2"><span class="ensaio-rotulo">{d.rotulo}</span>{ficha}</p>
      <div class="acoes entra" style="--i:3">
        <button type="button" class="botao" data-historia="0">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
          Assistir
        </button>
        <a class="botao-sec" href="#fotos">Ver todas as fotos</a>
      </div>
    </Heroi>

    <section class="secao fotos" id="fotos" aria-labelledby="fotos-titulo">
      <div class="wrap secao-topo surge">
        <p class="sobretitulo">O álbum</p>
        <h2 class="h2" id="fotos-titulo">{fotos.length} <em>fotos</em></h2>
      </div>
      <Galeria fotos={fotos} nome={d.nome} />
    </section>
  </article>

  {
    proximo && (
      <nav class="secao wrap proximo" aria-label="Próximo álbum">
        <a class="proximo-link surge" href={`/trabalhos/${proximo.id}`}>
          {capaProx && (
            <span class="proximo-foto" style={`view-transition-name: capa-${proximo.id}`}>
              <Foto slug={capaProx.slug} arquivo={capaProx.arquivo} alt="" sizes="(min-width: 900px) 60vw, 92vw" recorte="50% 30%" />
            </span>
          )}
          <span class="proximo-texto">
            <span class="proximo-rotulo">Próximo álbum</span>
            <span class="proximo-nome serifa">{proximo.data.nome}</span>
            <span class="proximo-ficha">
              {proximo.data.rotulo} · {proximo.data.data.slice(0, 4)}
            </span>
          </span>
          <span class="proximo-seta" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 12h14m0 0-6-6m6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      </nav>
    )
  }

  <section class="secao wrap" data-contato-ensaio aria-labelledby="contato-ensaio">
    <div class="contato couro surge">
      <h2 class="h2" id="contato-ensaio">{pergunta}</h2>
      <p class="texto">Conte o que você imagina, a data e a cidade. Eu respondo pelo WhatsApp.</p>
      <a class="botao botao-grande" href={linkWhatsApp(mensagem)}>Conversar no WhatsApp</a>
    </div>
  </section>

  <Historias historias={[{ nome: d.nome, legenda: [d.rotulo, d.data.slice(0, 4)].join(' · '), fotos }]} slot="depois" />
  <BarraWhatsApp mensagem={mensagem} slot="depois" />
</Base>

<style>
  .ensaio-titulo {
    font-size: clamp(52px, 15vw, 128px);
    line-height: 0.95;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .ensaio-ficha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: 15px;
    font-weight: 500;
    color: #e6e1d7;
  }
  .ensaio-rotulo {
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--verde);
  }
  a.sobretitulo {
    text-decoration: none;
    min-height: 44px;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
    margin-top: var(--s1);
  }
  .fotos .secao-topo {
    margin-bottom: var(--s3);
  }

  /* Próximo álbum: cartão de foto larga, com o nome por cima */
  .proximo-link {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(70svh, 560px);
    border-radius: var(--raio-g);
    overflow: hidden;
    isolation: isolate;
    color: #f2eee6;
    text-decoration: none;
    background: #0b110f;
    box-shadow: var(--sombra);
  }
  .proximo-link:hover {
    color: #f2eee6;
  }
  .proximo-link:active {
    transform: scale(0.98);
  }
  .proximo-foto {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .proximo-foto :global(.foto) {
    height: 100%;
    border-radius: 0;
  }
  .proximo-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(8 12 11 / 0.9), rgb(8 12 11 / 0) 60%);
  }
  .proximo-texto {
    display: grid;
    gap: 6px;
    padding: var(--s4) var(--s3);
    padding-right: 88px;
  }
  .proximo-rotulo {
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--verde);
  }
  .proximo-nome {
    font-size: clamp(38px, 10vw, 80px);
    line-height: 1;
  }
  .proximo-ficha {
    font-size: 14px;
    color: #ddd8ce;
  }
  .proximo-link::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 1;
    border: 1.5px dashed rgb(242 238 230 / 0.32);
    border-radius: calc(var(--raio-g) - 10px);
    pointer-events: none;
  }
  .proximo-seta {
    position: absolute;
    right: var(--s4);
    bottom: var(--s4);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 1px solid rgb(242 238 230 / 0.4);
    background: rgb(8 12 11 / 0.4);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #f2eee6;
    transition: transform 250ms var(--curva);
  }
  .proximo-link:hover .proximo-seta {
    transform: translateX(6px);
  }

  .contato {
    display: grid;
    gap: var(--s3);
    justify-items: center;
    text-align: center;
    padding: clamp(48px, 7vw, 112px) clamp(24px, 5vw, 72px);
  }
  .botao-grande {
    min-height: 56px;
    padding-inline: 36px;
    font-size: 18px;
  }
</style>
