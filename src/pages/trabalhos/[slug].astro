---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Album from '../../components/Album.astro';
import CapaAlbum from '../../components/CapaAlbum.astro';
import Galeria from '../../components/Galeria.astro';
import BarraWhatsApp from '../../components/BarraWhatsApp.astro';
import { ensaiosPublicaveis, fotosDoEnsaio, mesAno, dadosFoto, type Ensaio } from '../../lib/fotos';
import { CATEGORIAS, linkWhatsApp, site } from '../../data/site';

export async function getStaticPaths() {
  const ensaios = await ensaiosPublicaveis();
  return ensaios.map((e, i) => {
    const mesma = ensaios.filter((x) => x.data.categoria === e.data.categoria && x.id !== e.id);
    const proximo = mesma[0] ?? ensaios[(i + 1) % ensaios.length];
    return { params: { slug: e.id }, props: { ensaio: e, proximo: proximo.id !== e.id ? proximo : null } };
  });
}

interface Props {
  ensaio: Ensaio;
  proximo: Ensaio | null;
}
const { ensaio, proximo } = Astro.props;
const d = ensaio.data;
const fotos = fotosDoEnsaio(ensaio);
const abertura = fotos.find((f) => f.arquivo === d.abertura.arquivo)!;
const evento = d.categoria === 'eventos';
const ficha = [d.rotulo, d.cidade, mesAno(d.data)].filter(Boolean).join(' · ');
const pergunta = evento ? 'Tem um evento chegando?' : 'Quer um ensaio assim?';
const mensagem = evento
  ? `Olá, José Renato! Vi o trabalho "${d.nome}" no seu site e quero falar sobre um evento.`
  : `Olá, José Renato! Vi o ensaio "${d.nome}" no seu site e quero saber como fazer um.`;
const lugar = d.cidade ? ` em ${d.cidade}` : '';
const titulo = `${d.nome}, ${d.rotulo.toLowerCase()}${lugar} | Jr_Tech_OFC Fotografia`;
const descricao = `${d.rotulo} de ${d.nome}${lugar}, ${mesAno(d.data)}. ${fotos.length} fotos de José Renato, Jr_Tech_OFC Fotografia.`;
const capaProx = proximo ? dadosFoto(proximo.id, proximo.data.capa) : null;
const vertical = (w: number, h: number) => w / h < 0.8;
// Capa, página de abertura, fotos e contracapa; uma página branca deixa o total ímpar (última vista fecha à direita).
const completar = (fotos.length + 3) % 2 === 0;
---

<Base titulo={titulo} descricao={descricao} tema={d.tema} imagem={abertura.dados.og}>
  <article>
    <section class="wrap ensaio-album">
      <Album rotulo={`Álbum: ${d.nome}`} abertura>
        <div slot="fechado" class="ensaio-texto">
          <p class="sobretitulo"><a href={`/trabalhos?c=${d.categoria}`}>{CATEGORIAS[d.categoria].titulo}</a></p>
          <h1 class="ensaio-titulo serifa">{d.nome}</h1>
          <p class="legenda">{ficha} · {fotos.length} fotos</p>
          <div class="acoes">
            <button type="button" class="botao" data-album-abrir>Abrir o álbum</button>
            <a class="botao-sec" href="#todas">Ver todas em grade</a>
          </div>
        </div>

        <div class="pagina">
          <CapaAlbum foto={abertura} titulo={d.nome} sobre={site.marca} rodape={[d.cidade, d.data.slice(0, 4)].filter(Boolean).join(' · ')} sizes="(min-width: 900px) 30vw, 70vw" prioridade />
        </div>
        <div class="pagina pagina-couro pagina-texto abre">
          <p class="sobretitulo">{d.rotulo}</p>
          <p class="titulo-pagina">{d.nome}</p>
          <p class="legenda">{[d.cidade, mesAno(d.data)].filter(Boolean).join(' · ')}</p>
          <p class="legenda">{fotos.length} fotos · José Renato</p>
        </div>
        {
          fotos.map((f) => (
            <div class:list={['pagina pagina-papel pagina-foto', { sangria: vertical(f.dados.width, f.dados.height) }]}>
              <Foto slug={f.slug} arquivo={f.arquivo} alt={f.alt} sizes="(min-width: 900px) 34vw, 90vw" />
            </div>
          ))
        }
        {completar && <div class="pagina pagina-papel" />}
        <div class="pagina pagina-couro pagina-texto contracapa">
          <p class="contracapa-marca">{site.marca}</p>
          <p class="legenda">{site.slogan}</p>
        </div>
      </Album>
    </section>

    <section class="secao todas" id="todas" aria-labelledby="todas-titulo">
      <div class="wrap secao-topo">
        <h2 class="h2" id="todas-titulo">Todas as <em>fotos</em></h2>
      </div>
      <Galeria fotos={fotos} nome={d.nome} />
    </section>
  </article>
  {
    proximo && (
      <nav class="secao wrap proximo" aria-label="Próximo trabalho">
        <a class="couro" href={`/trabalhos/${proximo.id}`}>
          <span class="sobretitulo">Próximo trabalho</span>
          <span class="proximo-nome serifa">{proximo.data.nome}</span>
          <span class="legenda">
            {proximo.data.rotulo} · {proximo.data.data.slice(0, 4)}
          </span>
          {capaProx && (
            <img
              src={capaProx.srcset.webp.split(', ')[0].split(' ')[0]}
              alt=""
              width={capaProx.width}
              height={capaProx.height}
              loading="lazy"
              decoding="async"
            />
          )}
        </a>
      </nav>
    )
  }

  <section class="secao wrap" data-contato-ensaio aria-labelledby="contato-ensaio">
    <div class="contato couro">
      <h2 class="display-l" id="contato-ensaio">{pergunta}</h2>
      <p class="texto">Me diga o que você quer, a data e a cidade. Respondo pelo WhatsApp.</p>
      <a class="botao" href={linkWhatsApp(mensagem)}>Chamar no WhatsApp</a>
    </div>
  </section>

  <BarraWhatsApp mensagem={mensagem} slot="depois" />
</Base>

<style>
  .ensaio-album {
    min-height: calc(100svh - var(--cab));
    display: grid;
    align-content: center;
    padding-block: var(--s2);
  }
  .ensaio-texto {
    display: grid;
    gap: var(--s2);
    justify-items: start;
    margin-bottom: var(--s2);
  }
  .ensaio-titulo {
    font-size: clamp(44px, 5.6vw, 96px);
    line-height: 0.98;
  }
  .sobretitulo a {
    color: inherit;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s4);
    margin-top: var(--s1);
  }
  .abre {
    justify-items: center;
    text-align: center;
  }
  .contracapa {
    justify-items: center;
    text-align: center;
  }
  .contracapa-marca {
    font-family: var(--serifa);
    font-style: italic;
    font-size: clamp(28px, 5vh, 54px);
    background: linear-gradient(105deg, #00c98a, #8affd9 32%, #00fca8 50%, #1cdaff 78%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proximo a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--s1) var(--s4);
    padding: clamp(28px, 4vw, 56px);
    color: var(--texto);
    text-decoration: none;
    transition: transform var(--t-estado) var(--curva);
  }
  .proximo a:hover {
    transform: translateY(-2px);
  }
  .proximo a > span {
    grid-column: 1;
  }
  .proximo-nome {
    font-size: var(--display-l);
    line-height: 1;
    transition: color var(--t-estado);
  }
  .proximo a:hover .proximo-nome,
  .proximo a:focus-visible .proximo-nome {
    color: var(--link-hover);
    font-style: italic;
  }
  .proximo img {
    grid-column: 2;
    grid-row: 1 / span 3;
    width: clamp(96px, 16vw, 200px);
    border-radius: var(--raio-m);
    box-shadow: var(--sombra);
  }
  .contato {
    display: grid;
    gap: var(--s3);
    justify-items: center;
    text-align: center;
    padding: clamp(48px, 7vw, 112px) clamp(24px, 5vw, 72px);
  }
</style>
