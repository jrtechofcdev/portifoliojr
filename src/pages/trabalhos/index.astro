---
import Base from '../../layouts/Base.astro';
import ListaAlbuns from '../../components/ListaAlbuns.astro';
import Historias, { type Historia } from '../../components/Historias.astro';
import BarraWhatsApp from '../../components/BarraWhatsApp.astro';
import { ensaiosPublicaveis, fotosDoEnsaio } from '../../lib/fotos';
import { linkWhatsApp } from '../../data/site';

const ensaios = await ensaiosPublicaveis();
const historias: Historia[] = ensaios.map((e) => {
  const fotos = fotosDoEnsaio(e);
  const capa = fotos.find((f) => f.arquivo === e.data.capa);
  return {
    nome: e.data.nome,
    legenda: [e.data.rotulo, e.data.data.slice(0, 4)].join(' · '),
    href: `/trabalhos/${e.id}`,
    fotos: [...(capa ? [capa] : []), ...fotos.filter((f) => f !== capa).slice(0, 7)],
  };
});
---

<Base
  titulo="Trabalhos | Jr_Tech_OFC Fotografia"
  descricao="Ensaios externos, casais, gestantes, 15 anos e eventos fotografados por José Renato em Imperatriz e Bacabal, MA."
>
  <section class="indice">
    <div class="wrap indice-topo">
      <h1 class="display-l entra" style="--i:0">Os <em>álbuns</em></h1>
      <p class="texto apoio entra" style="--i:1">Toque num álbum para ver todas as fotos, ou no botão de assistir para passar uma a uma.</p>
    </div>

    {ensaios.length === 0 && <p class="wrap texto">Os trabalhos entram aqui assim que forem escolhidos na curadoria.</p>}
    <ListaAlbuns ensaios={ensaios} prioridade />
  </section>

  <section class="secao wrap" data-contato-ensaio aria-labelledby="cta-titulo">
    <div class="contato couro surge">
      <h2 class="h2" id="cta-titulo">Quer um álbum <em>assim?</em></h2>
      <p class="texto">Me diga o tipo de ensaio ou evento, a data e a cidade. Respondo pelo WhatsApp.</p>
      <a class="botao botao-grande" href={linkWhatsApp()}>Chamar no WhatsApp</a>
    </div>
  </section>

  <Historias historias={historias} slot="depois" />
  <BarraWhatsApp slot="depois" />
</Base>

<style>
  .indice {
    padding-top: var(--s4);
  }
  .indice-topo {
    display: grid;
    gap: var(--s2);
    margin-bottom: var(--s3);
  }
  .apoio {
    color: var(--texto-2);
  }
  .contato {
    display: grid;
    gap: var(--s3);
    justify-items: center;
    text-align: center;
    padding: clamp(48px, 7vw, 112px) clamp(24px, 5vw, 72px);
  }
  .botao-grande {
    min-height: 56px;
    padding-inline: 36px;
    font-size: 18px;
  }
</style>
