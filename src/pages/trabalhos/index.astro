---
import Base from '../../layouts/Base.astro';
import ListaAlbuns from '../../components/ListaAlbuns.astro';
import Historias, { type Historia } from '../../components/Historias.astro';
import BarraWhatsApp from '../../components/BarraWhatsApp.astro';
import Assistente from '../../components/Assistente.astro';
import { capasDe, ensaiosPublicaveis, fotosDoEnsaio } from '../../lib/fotos';
import { CAPA_SOCIAL, linkWhatsApp } from '../../data/site';
import Icone from '../../components/Icone.astro';

const ensaios = await ensaiosPublicaveis();
const historias: Historia[] = ensaios.map((e) => {
  const capas = capasDe(e);
  const resto = fotosDoEnsaio(e).filter((f) => !capas.includes(f));
  return {
    nome: e.data.nome,
    legenda: [e.data.rotulo, e.data.data.slice(0, 4)].join(' · '),
    href: `/trabalhos/${e.id}`,
    fotos: [...capas, ...resto.slice(0, 8 - capas.length)],
  };
});
---

<Base
  titulo="Trabalhos | Jr_Tech_OFC Fotografia"
  descricao="Ensaios externos, casais, gestantes, 15 anos e eventos fotografados por José Renato em Imperatriz e Bacabal, MA."
  imagem={CAPA_SOCIAL.imagem}
  social={{ imagemAlt: CAPA_SOCIAL.imagemAlt }}
>
  <section class="indice">
    <div class="wrap indice-topo">
      <p class="sobretitulo entra" style="--i:0">Portfólio</p>
      <h1 class="display-l entra" style="--i:1">Todos os <em>álbuns</em></h1>
      <p class="lead entra" style="--i:2">Ensaios, casais, gestantes, 15 anos e celebrações em Imperatriz e Bacabal.</p>
    </div>

    <Assistente variante="indice" alvo="#lista" />
    <span id="lista"></span>

    {ensaios.length === 0 && <p class="wrap texto">Os trabalhos entram aqui assim que forem escolhidos na curadoria.</p>}
    <ListaAlbuns ensaios={ensaios} prioridade />
  </section>

  <section class="secao wrap" data-contato-ensaio aria-labelledby="cta-titulo">
    <div class="contato couro surge">
      <p class="sobretitulo">Contato</p>
      <h2 class="h2" id="cta-titulo">Vamos criar o seu <em>álbum?</em></h2>
      <p class="lead">Conte o que você imagina, a data e a cidade. Eu respondo pelo WhatsApp.</p>
      <a class="botao botao-grande" href={linkWhatsApp()} data-wa-auto>
        <Icone nome="whatsapp" tamanho={22} />
        Pedir orçamento
      </a>
    </div>
  </section>

  <Historias historias={historias} slot="depois" />
  <BarraWhatsApp slot="depois" auto />
</Base>

<style>
  .indice {
    padding-top: var(--s4);
  }
  .indice-topo {
    display: grid;
    gap: var(--s2);
    justify-items: start;
    margin-bottom: var(--s4);
  }
  #lista {
    display: block;
    scroll-margin-top: calc(var(--cab) + 8px);
  }
  .apoio {
    color: var(--texto-2);
  }
  .contato {
    display: grid;
    gap: var(--s3);
    justify-items: center;
    text-align: center;
    padding: clamp(48px, 7vw, 112px) clamp(24px, 5vw, 72px);
  }
  .botao-grande {
    min-height: 56px;
    padding-inline: 32px;
    font-size: 18px;
  }
  .contato .lead {
    max-width: 30ch;
  }
</style>
